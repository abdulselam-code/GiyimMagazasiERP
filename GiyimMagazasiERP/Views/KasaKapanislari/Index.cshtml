@model GiyimMagazasiERP.ViewModels.KasaKapanisiListeViewModel
@using GiyimMagazasiERP.Models

@{
    ViewData["Title"] = "Kasa Kapanışları";
    var siraNo = ((Model.Page - 1) * Model.PageSize) + 1;

    string DurumMetni(string durum) => durum switch
    {
        KasaKapanisi.DurumHazirlandi => "Onay Bekliyor",
        KasaKapanisi.DurumOnaylandi => "Onaylandı",
        KasaKapanisi.DurumReddedildi => "Reddedildi",
        _ => durum
    };

    string DurumRengi(string durum) => durum switch
    {
        KasaKapanisi.DurumHazirlandi => "warning",
        KasaKapanisi.DurumOnaylandi => "success",
        KasaKapanisi.DurumReddedildi => "danger",
        _ => "secondary"
    };

    string FarkRengi(decimal fark) =>
        fark == 0 ? "text-success" :
        fark > 0 ? "text-primary" : "text-danger";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Kasa Kapanışları</h1>
            <p class="text-muted mb-0">
                Gün sonu satış, iade ve sayılan kasa tutarlarını karşılaştırın.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="BenimKapanislarim"
               class="btn btn-outline-secondary">
                Benim Kapanışlarım
            </a>
            <a asp-action="Create" class="btn btn-primary">
                Yeni Kasa Kapanışı
            </a>
        </div>
    </div>

    @if (TempData["Basari"] is not null)
    {
        <div class="alert alert-success">@TempData["Basari"]</div>
    }

    @if (TempData["Hata"] is not null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Bugünkü Beklenen</div>
                    <div class="h5 fw-bold mb-0">@Model.BugunkuBeklenenToplam.ToString("N2") TL</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Bugünkü Sayılan</div>
                    <div class="h5 fw-bold mb-0">@Model.BugunkuSayilanToplam.ToString("N2") TL</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Bugünkü Kasa Farkı</div>
                    <div class="h5 fw-bold mb-0 @FarkRengi(Model.BugunkuFark)">
                        @Model.BugunkuFark.ToString("N2") TL
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Onay Bekleyen</div>
                    <div class="h5 fw-bold text-warning mb-0">@Model.OnayBekleyenKapanis</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label asp-for="Arama" class="form-label">Arama</label>
                    <input asp-for="Arama"
                           class="form-control"
                           placeholder="Kapanış no, kasiyer veya kullanıcı" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label asp-for="Durum" class="form-label">Durum</label>
                    <select asp-for="Durum" class="form-select">
                        <option value="Tumu">Tümü</option>
                        <option value="@KasaKapanisi.DurumHazirlandi">Onay Bekliyor</option>
                        <option value="@KasaKapanisi.DurumOnaylandi">Onaylandı</option>
                        <option value="@KasaKapanisi.DurumReddedildi">Reddedildi</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label asp-for="KasaPersonelId" class="form-label">Kasiyer</label>
                    <select asp-for="KasaPersonelId"
                            asp-items="Model.Kasiyerler"
                            class="form-select">
                        <option value="">Tüm Kasiyerler</option>
                    </select>
                </div>

                <div class="col-lg-2 col-md-6">
                    <label asp-for="BaslangicTarihi" class="form-label">Başlangıç</label>
                    <input asp-for="BaslangicTarihi" type="date" class="form-control" />
                </div>

                <div class="col-lg-2 col-md-6">
                    <label asp-for="BitisTarihi" class="form-label">Bitiş</label>
                    <input asp-for="BitisTarihi" type="date" class="form-control" />
                </div>

                <div class="col-lg-1 col-md-6">
                    <label asp-for="PageSize" class="form-label">Kayıt</label>
                    <select asp-for="PageSize" class="form-select">
                        @foreach (var adet in new[] { 10, 25, 50, 100 })
                        {
                            <option value="@adet">@adet</option>
                        }
                    </select>
                </div>

                <div class="col-12 d-flex flex-wrap justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                <div class="text-muted">
                    Toplam <strong>@Model.TotalCount</strong> kayıt bulundu.
                </div>
                <div class="text-muted">
                    Sayfa <strong>@Model.Page</strong> / <strong>@Model.TotalPages</strong>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Kapanış No</th>
                            <th>Tarih</th>
                            <th>Kasiyer</th>
                            <th class="text-end">Beklenen</th>
                            <th class="text-end">Sayılan</th>
                            <th class="text-end">Fark</th>
                            <th>Durum</th>
                            <th>Oluşturma Tarihi</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var kapanis in Model.Items)
                            {
                                <tr>
                                    <td>@siraNo</td>
                                    <td class="fw-semibold">@kapanis.KapanisNo</td>
                                    <td>@kapanis.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td>@kapanis.KasaPersonel.AdSoyad</td>
                                    <td class="text-end">@kapanis.BeklenenToplam.ToString("N2") TL</td>
                                    <td class="text-end">@kapanis.SayilanToplam.ToString("N2") TL</td>
                                    <td class="text-end fw-semibold @FarkRengi(kapanis.FarkToplam)">
                                        @kapanis.FarkToplam.ToString("N2") TL
                                    </td>
                                    <td>
                                        <span class="badge text-bg-@DurumRengi(kapanis.Durum)">
                                            @DurumMetni(kapanis.Durum)
                                        </span>
                                    </td>
                                    <td>@kapanis.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@kapanis.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Detay
                                        </a>
                                    </td>
                                </tr>
                                siraNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">
                                    Arama kriterlerine uygun kasa kapanışı bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Kasa kapanışları sayfalama">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(!Model.OncekiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-durum="@Model.Durum"
                               asp-route-kasaPersonelId="@Model.KasaPersonelId"
                               asp-route-baslangicTarihi="@Model.BaslangicTarihi?.ToString("yyyy-MM-dd")"
                               asp-route-bitisTarihi="@Model.BitisTarihi?.ToString("yyyy-MM-dd")">
                                Önceki
                            </a>
                        </li>

                        @for (var sayfa = 1; sayfa <= Model.TotalPages; sayfa++)
                        {
                            <li class="page-item @(sayfa == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@sayfa"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-arama="@Model.Arama"
                                   asp-route-durum="@Model.Durum"
                                   asp-route-kasaPersonelId="@Model.KasaPersonelId"
                                   asp-route-baslangicTarihi="@Model.BaslangicTarihi?.ToString("yyyy-MM-dd")"
                                   asp-route-bitisTarihi="@Model.BitisTarihi?.ToString("yyyy-MM-dd")">
                                    @sayfa
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.SonrakiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-durum="@Model.Durum"
                               asp-route-kasaPersonelId="@Model.KasaPersonelId"
                               asp-route-baslangicTarihi="@Model.BaslangicTarihi?.ToString("yyyy-MM-dd")"
                               asp-route-bitisTarihi="@Model.BitisTarihi?.ToString("yyyy-MM-dd")">
                                Sonraki
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
