@model GiyimMagazasiERP.ViewModels.SqlYoneticiViewModel

@{
    ViewData["Title"] = "SQL / Rapor Yönetici Paneli";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">SQL / Rapor Yönetici Paneli</h1>
        <p class="text-muted mb-0">
            Güvenli hazır rapor sorguları ile veritabanı sonuçlarını görüntüleme paneli
        </p>
    </div>

    <div class="alert alert-info border-0 shadow-sm mb-4">
        Bu panelde yalnızca sistemde tanımlı hazır SELECT tabanlı raporlar çalıştırılır.
        Serbest SQL girişi kapalıdır.
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <section class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 fw-bold mb-3">Hazır Sorgular</h2>

                    <div class="d-grid gap-2">
                        @foreach (var rapor in Model.HazirRaporlar)
                        {
                            var seciliMi = Model.SeciliRaporKodu == rapor.Kod;

                            <a asp-controller="SqlYonetici"
                               asp-action="Index"
                               asp-route-raporKodu="@rapor.Kod"
                               class="btn @(seciliMi ? "btn-dark" : "btn-outline-secondary") text-start">
                                <span class="d-block fw-semibold">@rapor.Baslik</span>
                                <small class="d-block mt-1 @(seciliMi ? "text-white-50" : "text-muted")">
                                    @rapor.Aciklama
                                </small>
                            </a>
                        }
                    </div>
                </div>
            </section>
        </div>

        <div class="col-lg-8">
            @if (Model.SonucTablosu is null)
            {
                <section class="card border-0 shadow-sm">
                    <div class="card-body py-5 text-center">
                        <h2 class="h5 fw-bold">Rapor Seçimi Bekleniyor</h2>
                        <p class="text-muted mb-0">
                            Soldaki hazır sorgulardan birini seçerek sonucu tablo halinde görüntüleyebilirsin.
                        </p>
                    </div>
                </section>
            }
            else
            {
                <section class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="mb-3">
                            <h2 class="h5 fw-bold mb-1">@Model.SonucTablosu.Baslik</h2>
                            <p class="text-muted mb-0">@Model.SonucTablosu.Aciklama</p>
                        </div>

                        @if (Model.SonucTablosu.Satirlar.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            @foreach (var sutun in Model.SonucTablosu.Sutunlar)
                                            {
                                                <th>@sutun</th>
                                            }
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var satir in Model.SonucTablosu.Satirlar)
                                        {
                                            <tr>
                                                @foreach (var sutun in Model.SonucTablosu.Sutunlar)
                                                {
                                                    <td>
                                                        @(satir.TryGetValue(sutun, out var deger) ? deger : "-")
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                Bu rapor için kayıt bulunamadı.
                            </div>
                        }
                    </div>
                </section>
            }
        </div>
    </div>
</div>