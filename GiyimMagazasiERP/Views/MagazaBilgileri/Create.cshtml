@model GiyimMagazasiERP.Models.MagazaBilgileri
@{
    ViewData["Title"] = "Mağaza Bilgisi Ekle";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold mb-4">Mağaza Bilgisi Ekle</h1>
            <form asp-action="Create" method="post">
                <partial name="_MagazaFormu" model="Model" />
                <button class="btn btn-primary" type="submit">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>