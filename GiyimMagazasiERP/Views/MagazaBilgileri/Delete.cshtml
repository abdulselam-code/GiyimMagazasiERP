@model GiyimMagazasiERP.Models.MagazaBilgileri
@{
    ViewData["Title"] = "Mağaza Bilgisini Pasifleştir";
}
<div class="container py-4">
    <div class="card border-warning shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold">Mağaza Bilgisini Pasifleştir</h1>
            <p><strong>@Model.MagazaAdi</strong> kaydı pasif duruma getirilecek.</p>
            <form asp-action="Delete" method="post">
                <input asp-for="Id" type="hidden" />
                <button class="btn btn-warning" type="submit">Pasifleştir</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        </div>
    </div>
</div>