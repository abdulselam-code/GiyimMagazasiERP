@model GiyimMagazasiERP.Models.UrunTedarikci
@{
    var urun = ViewData["Urun"] as GiyimMagazasiERP.Models.Urun;
    ViewData["Title"] = "Ürüne Tedarikçi Ekle";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Ürüne Tedarikçi Ekle</h1>
            <p class="text-muted mb-0">@urun?.UrunAdi için satın alma koşullarını tanımlayın.</p>
        </div>
        <a asp-controller="Urunler" asp-action="Details" asp-route-id="@Model.UrunId"
           class="btn btn-outline-secondary">Ürüne Dön</a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">
                <input asp-for="UrunId" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <partial name="_Form" model="Model" />
                <div class="mt-4 d-flex gap-2">
                    <button class="btn btn-primary">Tedarikçiyi Ekle</button>
                    <a asp-controller="Urunler" asp-action="Details" asp-route-id="@Model.UrunId"
                       class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
