@model List<GiyimMagazasiERP.ViewModels.FaturaListeViewModel>

@{
    ViewData["Title"] = "Faturalar";
    var siraNo = 1;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Faturalar</h1>
            <p class="text-muted mb-0">
                Oluşturulan satış faturalarını görüntüleyin.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="SatisIslemleri"
               asp-action="Create"
               class="btn btn-success">
                Yeni Satış Yap
            </a>

            <a asp-controller="Satislar"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Satışlara Dön
            </a>
        </div>
    </div>

    @if (ViewData["KasiyerUyari"] is not null)
    {
        <div class="alert alert-warning">
            @ViewData["KasiyerUyari"]
        </div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label for="arama" class="form-label">Fatura Ara</label>
                    <input id="arama"
                           name="arama"
                           value="@ViewData["Arama"]"
                           class="form-control"
                           placeholder="FAT-000025, müşteri veya ödeme tipi ara" />
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">Ara</button>
                    <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Satış No</th>
                                <th>Fatura No</th>
                                <th>Tarih</th>
                                <th>Saat</th>
                                <th>Müşteri</th>
                                <th>Satış Türü</th>
                                <th>Ödeme Tipi</th>
                                <th class="text-end">Toplam Tutar</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var fatura in Model)
                            {
                                <tr>
                                    <td>@(siraNo++)</td>
                                    <td>#@fatura.SatisId</td>
                                    <td>@fatura.FaturaNo</td>
                                    <td>@fatura.SatisTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>@fatura.SatisTarihi.ToString("HH:mm")</td>
                                    <td>@fatura.MusteriAdi</td>
                                    <td>
                                        <span class="badge text-bg-primary">
                                            @fatura.SatisTuru
                                        </span>
                                    </td>
                                    <td>@fatura.OdemeTipi</td>
                                    <td class="text-end fw-semibold">
                                        @fatura.ToplamTutar.ToString("N2") TL
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Faturalar"
                                           asp-action="Detay"
                                           asp-route-id="@fatura.SatisId"
                                           class="btn btn-sm btn-outline-primary">
                                            Görüntüle
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    Henüz fatura kaydı bulunmuyor.
                </div>
            }
        </div>
    </div>
</div>