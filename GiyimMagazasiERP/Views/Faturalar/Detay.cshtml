@model GiyimMagazasiERP.ViewModels.FaturaDetayViewModel

@{
    ViewData["Title"] = "Satış Faturası";

    var magaza = ViewBag.Magaza as GiyimMagazasiERP.Models.MagazaBilgileri;

    var magazaAdi = !string.IsNullOrWhiteSpace(magaza?.TicariUnvan)
        ? magaza.TicariUnvan
        : magaza?.MagazaAdi ?? "Giyim Mağazası ERP";

    var adres = magaza?.Adres ?? "Merkez / Türkiye";

    var ilIlce = string.Join(" / ",
        new[] { magaza?.Ilce, magaza?.Il }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    var telefon = magaza?.Telefon ?? "0555 000 00 00";
    var email = magaza?.Email ?? "info@giyimerp.local";
    var webAdresi = magaza?.WebAdresi;
    var vergiDairesi = magaza?.VergiDairesi ?? "Merkez";
    var vergiNo = magaza?.VergiNo ?? "0000000000";
    var mersisNo = magaza?.MersisNo;
    var ticaretSicilNo = magaza?.TicaretSicilNo;

    var satisTuru = string.IsNullOrWhiteSpace(Model.SatisTuru)
        ? "Perakende"
        : Model.SatisTuru;

    var belgeTuru = Model.BelgeTuru switch
    {
        "SatisBelgesi" => "Satış Belgesi",
        "SatisFaturasi" => "Satış Faturası",
        null or "" => "Satış Belgesi",
        _ => Model.BelgeTuru
    };

    var belgeDurumu = Model.FaturaDurumu switch
    {
        "Olusturuldu" => "Oluşturuldu",
        "Iptal" => "İptal",
        "Iade" => "İade",
        "Taslak" => "Taslak",
        null or "" => "Oluşturuldu",
        _ => Model.FaturaDurumu
    };

    var kurumsalMusteri =
        Model.KayitliMusteriMi &&
        string.Equals(
            Model.MusteriTipi,
            "Kurumsal",
            StringComparison.OrdinalIgnoreCase);

    var odenecekTutar = Model.VergiDahilToplam > 0
        ? Model.VergiDahilToplam
        : Model.NetTutar;

    var kalemSiraNo = 1;
}

<style>
    .invoice-page {
        min-height: 100vh;
        padding: 32px 16px;
