<div class="invoice-page">
    <div class="invoice-actions d-flex flex-wrap justify-content-between align-items-center gap-3 no-print">
        <div>
            <h1 class="h3 fw-bold mb-1">Satış Faturası</h1>
            <p class="text-muted mb-0">
                Satış kaydından oluşturulan yazdırılabilir belge
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button type="button"
                    class="btn btn-primary"
                    onclick="window.print()">
                Yazdır
            </button>

            <a asp-controller="Faturalar"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Faturalara Dön
            </a>

            <a asp-controller="Satislar"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Satışlara Dön
            </a>
        </div>
    </div>

    <article class="invoice-paper">
        <header class="invoice-header">
            <div class="invoice-brand">
                <h1>@magazaAdi</h1>
                <h2>SATIŞ FATURASI</h2>
                <p>ERP sistemi tarafından oluşturulan satış belgesi</p>
            </div>

            <div class="invoice-meta">
                <h3>Fatura Bilgileri</h3>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Fatura No</span>
                    <span class="invoice-meta-value">@Model.FaturaNo</span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Satış No</span>
                    <span class="invoice-meta-value">#@Model.SatisId</span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Fatura Tarihi</span>
                    <span class="invoice-meta-value">
                        @Model.FaturaTarihi.ToString("dd.MM.yyyy")
                    </span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Fatura Saati</span>
                    <span class="invoice-meta-value">
                        @Model.FaturaTarihi.ToString("HH:mm")
                    </span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Satış Türü</span>
                    <span class="invoice-meta-value">@satisTuru</span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Ödeme Tipi</span>
                    <span class="invoice-meta-value">@Model.OdemeTipi</span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Belge Türü</span>
                    <span class="invoice-meta-value">@belgeTuru</span>
                </div>

                <div class="invoice-meta-row">
                    <span class="invoice-meta-label">Belge Durumu</span>
                    <span class="invoice-status">@belgeDurumu</span>
                </div>
            </div>
        </header>

        <section class="invoice-info-grid">
            <div class="invoice-info-box">
                <h4>Satıcı / Mağaza Bilgileri</h4>
                <p><strong>@magazaAdi</strong></p>
                <p><strong>Adres:</strong> @adres</p>

                @if (!string.IsNullOrWhiteSpace(ilIlce))
                {
                    <p><strong>İl / İlçe:</strong> @ilIlce</p>
                }

                <p><strong>Telefon:</strong> @telefon</p>
                <p><strong>E-posta:</strong> @email</p>

                @if (!string.IsNullOrWhiteSpace(webAdresi))
                {
                    <p><strong>Web:</strong> @webAdresi</p>
                }

                <p><strong>Vergi Dairesi:</strong> @vergiDairesi</p>
                <p><strong>Vergi No:</strong> @vergiNo</p>

                @if (!string.IsNullOrWhiteSpace(mersisNo))
                {
                    <p><strong>Mersis No:</strong> @mersisNo</p>
                }

                @if (!string.IsNullOrWhiteSpace(ticaretSicilNo))
                {
                    <p>
                        <strong>Ticaret Sicil No:</strong>
                        @ticaretSicilNo
                    </p>
                }
            </div>

            <div class="invoice-info-box">
                <h4>Müşteri Bilgileri</h4>

                @if (!Model.KayitliMusteriMi)
                {
                    <div class="customer-name">Nihai Tüketici</div>

                    <p>
                        <span class="badge text-bg-secondary">
                            Kayıtsız Müşteri
                        </span>
                    </p>

                    <p><strong>Telefon:</strong> -</p>
                    <p><strong>E-posta:</strong> -</p>
                    <p><strong>Adres:</strong> -</p>
                }
                else if (kurumsalMusteri)
                {
                    var kurumsalAdres = string.Join(" / ",
                        new[] { Model.MusteriIlce, Model.MusteriIl }
                            .Where(x => !string.IsNullOrWhiteSpace(x)));

                    <div class="customer-name">
                        @(Model.KurumsalUnvan ?? Model.MusteriAdi)
                    </div>

                    <p>
                        <span class="badge text-bg-primary">Kurumsal</span>
                    </p>

                    <p>
                        <strong>Yetkili / Müşteri:</strong>
                        @Model.MusteriAdi
                    </p>
                    <p><strong>VKN:</strong> @(Model.MusteriVKN ?? "-")</p>
                    <p>
                        <strong>Vergi Dairesi:</strong>
                        @(Model.MusteriVergiDairesi ?? "-")
                    </p>
                    <p>
                        <strong>Telefon:</strong>
                        @(Model.MusteriTelefon ?? "-")
                    </p>
                    <p>
                        <strong>E-posta:</strong>
                        @(Model.MusteriEmail ?? "-")
                    </p>
                    <p>
                        <strong>Adres:</strong>
                        @(Model.MusteriAdres ?? "-")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(kurumsalAdres))
                    {
                        <p>
                            <strong>İl / İlçe:</strong>
                            @kurumsalAdres
                        </p>
                    }
                }
                else
                {
                    var bireyselAdres = string.Join(" / ",
                        new[] { Model.MusteriIlce, Model.MusteriIl }
                            .Where(x => !string.IsNullOrWhiteSpace(x)));

                    <div class="customer-name">@Model.MusteriAdi</div>

                    <p>
                        <span class="badge text-bg-secondary">Bireysel</span>
                    </p>

                    <p>
                        <strong>TCKN:</strong>
                        @(Model.MusteriTCKN ?? "-")
                    </p>
                    <p>
                        <strong>Vergi Dairesi:</strong>
                        @(Model.MusteriVergiDairesi ?? "-")
                    </p>
                    <p>
                        <strong>Telefon:</strong>
                        @(Model.MusteriTelefon ?? "-")
                    </p>
                    <p>
                        <strong>E-posta:</strong>
                        @(Model.MusteriEmail ?? "-")
                    </p>
                    <p>
                        <strong>Adres:</strong>
                        @(Model.MusteriAdres ?? "-")
                    </p>

                    @if (!string.IsNullOrWhiteSpace(bireyselAdres))
                    {
                        <p>
                            <strong>İl / İlçe:</strong>
                            @bireyselAdres
                        </p>
                    }
                }
            </div>

            <div class="invoice-info-box">
                <h4>Satış Bilgileri</h4>

                <p>
                    <strong>Satışı Yapan:</strong>
                    @Model.PersonelAdi

                    @if (!string.IsNullOrWhiteSpace(Model.PersonelPozisyonu) &&
                         Model.PersonelPozisyonu != "-")
                    {
                        <text> - @Model.PersonelPozisyonu</text>
                    }
                </p>

                <p><strong>Satış Türü:</strong> @satisTuru</p>
                <p><strong>Ödeme Tipi:</strong> @Model.OdemeTipi</p>
                <p><strong>Belge Türü:</strong> @belgeTuru</p>
                <p><strong>Fatura Durumu:</strong> @belgeDurumu</p>
                <p>
                    <strong>Belge Oluşturma:</strong>
                    @Model.FaturaTarihi.ToString("dd.MM.yyyy HH:mm")
                </p>
            </div>
        </section>

        <section class="invoice-section">
            <h4 class="invoice-section-title">
                Ürün / Hizmet Kalemleri
            </h4>

            <div class="invoice-items-wrapper">
                <table class="table table-bordered invoice-items-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ürün / Hizmet</th>
                            <th>Barkod</th>
                            <th>Beden</th>
                            <th>Renk</th>
                            <th class="text-end">Miktar</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">İndirim</th>
                            <th class="text-end">KDV</th>
                            <th class="text-end">Tutar</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Kalemler.Any())
                        {
                            @foreach (var kalem in Model.Kalemler)
                            {
                                <tr>
                                    <td>@(kalemSiraNo++)</td>

                                    <td class="invoice-product-name">
                                        @kalem.UrunAdi
                                    </td>

                                    <td>@kalem.Barkod</td>
                                    <td>@kalem.Beden</td>
                                    <td>@kalem.Renk</td>
                                    <td class="text-end">@kalem.Adet</td>

                                    <td class="text-end">
                                        @kalem.BirimFiyat.ToString("N2") TL
                                    </td>

                                    <td class="text-end">
                                        @kalem.IndirimTutari.ToString("N2") TL
                                    </td>

                                    <td class="text-end invoice-vat-cell">
                                        <div class="invoice-vat-rate">
                                            %@kalem.KdvOrani.ToString("N2")
                                        </div>
                                        <div class="invoice-vat-amount">
                                            @kalem.KdvTutari.ToString("N2") TL
                                        </div>
                                    </td>

                                    <td class="text-end invoice-line-total">
                                        @kalem.ToplamTutar.ToString("N2") TL
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10"
                                    class="text-center text-muted py-4">
                                    Faturaya bağlı ürün kalemi bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="invoice-bottom-grid">
            <div class="invoice-left-bottom">
                <div class="invoice-delivery">
                    <h4>Teslim / İrsaliye Bilgileri</h4>
                    <p>
                        <strong>Teslim Tarihi:</strong>
                        @Model.FaturaTarihi.ToString("dd.MM.yyyy")
                    </p>
                    <p><strong>İrsaliye No:</strong> -</p>
                    <p>
                        <strong>Teslim Şekli:</strong>
                        Mağaza Satışı / Elden Teslim
                    </p>
                </div>

                <div class="invoice-verification">
                    <h4>Belge Doğrulama</h4>
                    <p><strong>Fatura No:</strong> @Model.FaturaNo</p>
                    <p><strong>Satış No:</strong> #@Model.SatisId</p>
                    <p>
                        <strong>Tarih:</strong>
                        @Model.FaturaTarihi.ToString("dd.MM.yyyy HH:mm")
                    </p>
                    <p>
                        <strong>Net Tutar:</strong>
                        @Model.NetTutar.ToString("N2") TL
                    </p>
                    <p>
                        <strong>UUID:</strong>
                        @(string.IsNullOrWhiteSpace(Model.UUID) ? "-" : Model.UUID)
                    </p>
                </div>

                <div class="invoice-return-info">
                    <h4>İade / Değişim Bilgilendirmesi</h4>

                    <ul>
                        <li>
                            İade ve değişim işlemleri için fatura numarası ile
                            başvurunuz.
                        </li>
                        <li>
                            İade/değişim talepleri ürün durumu ve mağaza
                            politikalarına göre değerlendirilir.
                        </li>
                        <li>
                            Onaylanan iadelerde ilgili satış kaydı üzerinden
                            iade süreci başlatılır.
                        </li>
                        <li>
                            İade işlemi gerçekleşirse sistemde ayrıca iade
                            kaydı/faturası oluşturulur.
                        </li>
                    </ul>
                </div>
            </div>

            <div class="invoice-summary">
                <div class="invoice-summary-row">
                    <span>Vergi Hariç Toplam</span>
                    <strong>@Model.VergiHaricToplam.ToString("N2") TL</strong>
                </div>

                <div class="invoice-summary-row">
                    <span>Toplam KDV</span>
                    <strong>@Model.ToplamKdvTutari.ToString("N2") TL</strong>
                </div>

                <div class="invoice-summary-row">
                    <span>Ara Toplam</span>
                    <strong>@Model.ToplamTutar.ToString("N2") TL</strong>
                </div>

                <div class="invoice-summary-row">
                    <span>Toplam İndirim</span>
                    <strong>@Model.IndirimTutari.ToString("N2") TL</strong>
                </div>

                <div class="invoice-summary-row">
                    <span>Net Toplam</span>
                    <strong>@Model.NetTutar.ToString("N2") TL</strong>
                </div>

                <div class="invoice-summary-row invoice-payable">
                    <span>KDV Dahil Ödenecek Tutar</span>
                    <strong>@odenecekTutar.ToString("N2") TL</strong>
                </div>
            </div>
        </section>

        <section class="invoice-signature">
            <h4>Yetkili İmza / Kaşe</h4>
            <div class="invoice-signature-line"></div>
        </section>
    </article>
</div>