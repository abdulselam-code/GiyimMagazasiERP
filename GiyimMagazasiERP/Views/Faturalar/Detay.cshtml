@model GiyimMagazasiERP.ViewModels.FaturaDetayViewModel

@{
    ViewData["Title"] = "Fatura Görüntüleme";

    var magaza = ViewBag.Magaza as GiyimMagazasiERP.Models.MagazaBilgileri;

    var magazaAdi = magaza?.MagazaAdi ?? "Giyim Mağazası ERP";
    var adres = magaza?.Adres ?? "Merkez / Türkiye";
    var telefon = magaza?.Telefon ?? "0555 000 00 00";
    var email = magaza?.Email ?? "info@giyimerp.local";
    var vergiDairesi = magaza?.VergiDairesi ?? "Merkez";
    var vergiNo = magaza?.VergiNo ?? "0000000000";

    var satisTuru = ViewBag.SatisTuru?.ToString() ?? "Perakende";

    var genelToplam = Model.NetTutar;
    var araToplam = Model.ToplamTutar;
    var indirimTutari = Model.IndirimTutari;
    var indirimOrani = araToplam > 0 ? (indirimTutari / araToplam) * 100 : 0;
    var kdvHaric = genelToplam / 1.20m;
    var kdvTutari = genelToplam - kdvHaric;
}

<div class="container py-4 invoice-page">
    <div class="d-flex justify-content-between align-items-center mb-3 invoice-print-actions">
        <div>
            <h1 class="h3 fw-bold mb-1">Fatura Görüntüleme</h1>
            <p class="text-muted mb-0">Satış kaydından oluşturulan fatura özeti</p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary" onclick="window.print()">
                Yazdır
            </button>

            <a asp-controller="Satislar"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Satışlara Dön
            </a>
        </div>
    </div>

    <article class="invoice-card">
        <header class="invoice-header">
            <div>
                <h2>@magazaAdi</h2>
                <p>@adres</p>
                <p>Telefon: @telefon</p>
                <p>E-posta: @email</p>
                <p>Vergi Dairesi: @vergiDairesi</p>
                <p>VKN: @vergiNo</p>
            </div>

            <div class="invoice-meta">
                <h3>FATURA</h3>
                <p><strong>Fatura No:</strong> FAT-@Model.SatisId.ToString("D6")</p>
                <p><strong>Tarih:</strong> @Model.SatisTarihi.ToString("dd.MM.yyyy")</p>
                <p><strong>Saat:</strong> @Model.SatisTarihi.ToString("HH:mm")</p>
                <p><strong>Satış Türü:</strong> @satisTuru</p>
                <p><strong>Ödeme Tipi:</strong> @Model.OdemeTipi</p>
            </div>
        </header>
        <section class="invoice-info-grid">
            <div class="invoice-info-box">
                <h4>Alıcı / Müşteri Bilgileri</h4>

                @if (Model.KayitliMusteriMi)
                {
                    <strong>@Model.MusteriAdi</strong>
                    <p>Telefon: @(Model.MusteriTelefon ?? "-")</p>
                    <p>Email: @(Model.MusteriEmail ?? "-")</p>
                }
                else
                {
                    <strong>Nihai Tüketici</strong>
                    <span class="badge text-bg-secondary mt-2">Kayıtsız Müşteri</span>
                }
            </div>
        </section>

        <div class="invoice-operator-note">
            İşlemi yapan:
            <strong>
                @Model.PersonelAdi
                @if (!string.IsNullOrWhiteSpace(Model.PersonelPozisyonu))
                {
                    <text> - @Model.PersonelPozisyonu</text>
                }
            </strong>
        </div>

        <section class="mt-4">
            <h4 class="invoice-section-title">Ürün Kalemleri</h4>

            <div class="table-responsive">
                <table class="table table-bordered align-middle invoice-table">
                    <thead>
                        <tr>
                            <th>Ürün Adı</th>
                            <th>Barkod</th>
                            <th>Beden</th>
                            <th>Renk</th>
                            <th class="text-end">Adet</th>
                            <th class="text-end">Birim Fiyat</th>
                            <th class="text-end">KDV Dahil Toplam</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var kalem in Model.Kalemler)
                        {
                            <tr>
                                <td>@kalem.UrunAdi</td>
                                <td>@kalem.Barkod</td>
                                <td>@kalem.Beden</td>
                                <td>@kalem.Renk</td>
                                <td class="text-end">@kalem.Adet</td>
                                <td class="text-end">@kalem.BirimFiyat.ToString("N2") TL</td>
                                <td class="text-end fw-semibold">@kalem.ToplamTutar.ToString("N2") TL</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="invoice-total-wrap">
            <div class="invoice-total-box">
                <div>
                    <span>Ara Toplam</span>
                    <strong>@araToplam.ToString("N2") TL</strong>
                </div>

                <div>
                    <span>İndirim Oranı</span>
                    <strong>%@indirimOrani.ToString("N2")</strong>
                </div>

                <div>
                    <span>İndirim Tutarı</span>
                    <strong>@indirimTutari.ToString("N2") TL</strong>
                </div>

                <div>
                    <span>KDV Oranı</span>
                    <strong>%20</strong>
                </div>

                <div>
                    <span>KDV Hariç Tutar</span>
                    <strong>@kdvHaric.ToString("N2") TL</strong>
                </div>

                <div>
                    <span>KDV Tutarı</span>
                    <strong>@kdvTutari.ToString("N2") TL</strong>
                </div>

                <div class="invoice-grand-total">
                    <span>KDV Dahil Genel Toplam</span>
                    <strong>@genelToplam.ToString("N2") TL</strong>
                </div>
            </div>
        </section>
    </article>
</div>