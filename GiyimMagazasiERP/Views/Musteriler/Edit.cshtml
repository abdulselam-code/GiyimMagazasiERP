@model GiyimMagazasiERP.Models.Musteri

@{
    ViewData["Title"] = "Müşteri Düzenle";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold mb-4">Müşteri Düzenle</h1>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="KayitTarihi" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="AdSoyad" class="form-label">Ad Soyad</label>
                        <input asp-for="AdSoyad" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Telefon" class="form-label">Telefon</label>
                        <input asp-for="Telefon" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="MusteriTipi" class="form-label">Müşteri Tipi</label>
                        <select asp-for="MusteriTipi" class="form-select">
                            <option value="Bireysel">Bireysel</option>
                            <option value="Kurumsal">Kurumsal</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="KurumsalUnvan" class="form-label">Kurumsal Ünvan</label>
                        <input asp-for="KurumsalUnvan" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TCKN" class="form-label">TCKN</label>
                        <input asp-for="TCKN" class="form-control" maxlength="11" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="VKN" class="form-label">VKN</label>
                        <input asp-for="VKN" class="form-control" maxlength="10" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="VergiDairesi" class="form-label">Vergi Dairesi</label>
                        <input asp-for="VergiDairesi" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Il" class="form-label">İl</label>
                        <input asp-for="Il" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Ilce" class="form-label">İlçe</label>
                        <input asp-for="Ilce" class="form-control" />
                    </div>

                    <div class="col-12">
                        <label asp-for="Adres" class="form-label">Adres</label>
                        <textarea asp-for="Adres" class="form-control" rows="3"></textarea>
                    </div>


                    <div class="col-md-3">
                        <label asp-for="SadakatPuani" class="form-label">Sadakat Puanı</label>
                        <input asp-for="SadakatPuani" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="IndirimOrani" class="form-label">İndirim Oranı</label>
                        <input asp-for="IndirimOrani" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ToplamHarcama" class="form-label">Toplam Harcama</label>
                        <input asp-for="ToplamHarcama" class="form-control" />
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>