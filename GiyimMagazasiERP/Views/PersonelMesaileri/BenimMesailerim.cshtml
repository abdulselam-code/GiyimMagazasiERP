@model GiyimMagazasiERP.ViewModels.PersonelMesaiListeViewModel
@using GiyimMagazasiERP.Models

@{
    ViewData["Title"] = "Benim Mesailerim";
    var yonetebilir = User.IsInRole("Admin") || User.IsInRole("Yonetici") || User.IsInRole("InsanKaynaklari");
    var olusturabilir = !User.IsInRole("Muhasebe");

    string DurumMetni(string durum) => durum switch
    {
        PersonelMesaiKaydi.DurumOnayBekliyor => "Onay Bekliyor",
        PersonelMesaiKaydi.DurumOnaylandi => "Onaylandı",
        PersonelMesaiKaydi.DurumReddedildi => "Reddedildi",
        PersonelMesaiKaydi.DurumIptalEdildi => "İptal Edildi",
        _ => durum
    };
    string DurumRengi(string durum) => durum switch
    {
        PersonelMesaiKaydi.DurumOnayBekliyor => "warning",
        PersonelMesaiKaydi.DurumOnaylandi => "success",
        PersonelMesaiKaydi.DurumReddedildi => "danger",
        _ => "secondary"
    };
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Benim Mesai ve Vardiya Kayıtlarım</h1>
            <p class="text-muted mb-0">Çalışma saatlerinizi, fazla mesai taleplerinizi ve onay durumlarını takip edin.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (yonetebilir)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Tüm Mesailer</a>
            }
            @if (olusturabilir)
            {
                <a asp-action="Create" class="btn btn-primary">Yeni Fazla Mesai Talebi</a>
            }
        </div>
    </div>

    @if (TempData["Basari"] is not null) { <div class="alert alert-success">@TempData["Basari"]</div> }
    @if (TempData["Hata"] is not null) { <div class="alert alert-danger">@TempData["Hata"]</div> }
    @if (!Model.PersonelEslesmesiVarMi)
    {
        <div class="alert alert-warning">Bu kullanıcıya bağlı aktif personel kaydı bulunamadı.</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100 border-start border-4 border-primary"><div class="card-body"><div class="text-muted small">Bu Ay Planlanan Saat</div><strong class="fs-4 text-primary">@Model.Ozet.BuAyToplamPlanlananSaat.ToString("N2")</strong></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100 border-start border-4 border-info"><div class="card-body"><div class="text-muted small">Bu Ay Gerçekleşen Saat</div><strong class="fs-4 text-info">@Model.Ozet.BuAyToplamGerceklesenSaat.ToString("N2")</strong></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100 border-start border-4 border-success"><div class="card-body"><div class="text-muted small">Bu Ay Onaylı Fazla Mesai</div><strong class="fs-4 text-success">@Model.Ozet.OnayliFazlaMesaiSaati.ToString("N2")</strong></div></div></div>
        <div class="col-sm-6 col-xl-3"><div class="card border-0 shadow-sm h-100 border-start border-4 border-warning"><div class="card-body"><div class="text-muted small">Bekleyen Taleplerim</div><strong class="fs-4 text-warning">@Model.Ozet.OnayBekleyenSayisi</strong></div></div></div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6"><label class="form-label" for="arama">Arama</label><input id="arama" name="arama" value="@Model.Arama" class="form-control" placeholder="Tür veya açıklama" /></div>
                <div class="col-lg-2 col-md-6"><label class="form-label" for="durum">Durum</label><select id="durum" name="durum" class="form-select"><option value="Tumu">Tümü</option>@foreach (var durum in new[] { PersonelMesaiKaydi.DurumOnayBekliyor, PersonelMesaiKaydi.DurumOnaylandi, PersonelMesaiKaydi.DurumReddedildi, PersonelMesaiKaydi.DurumIptalEdildi }) { <option value="@durum" selected="@(Model.Durum == durum)">@DurumMetni(durum)</option> }</select></div>
                <div class="col-lg-2 col-md-6"><label class="form-label" for="mesaiTuru">Mesai Türü</label><select id="mesaiTuru" name="mesaiTuru" class="form-select"><option value="Tumu">Tümü</option>@foreach (var tur in PersonelMesaiKaydi.MesaiTurleri) { <option value="@tur" selected="@(Model.MesaiTuru == tur)">@tur</option> }</select></div>
                <div class="col-lg-2 col-md-6"><label class="form-label" for="baslangicTarihi">Başlangıç</label><input id="baslangicTarihi" type="date" name="baslangicTarihi" value="@Model.BaslangicTarihi?.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-lg-2 col-md-6"><label class="form-label" for="bitisTarihi">Bitiş</label><input id="bitisTarihi" type="date" name="bitisTarihi" value="@Model.BitisTarihi?.ToString("yyyy-MM-dd")" class="form-control" /></div>
                <div class="col-lg-1 col-md-6"><label class="form-label" for="pageSize">Kayıt</label><select id="pageSize" name="pageSize" class="form-select">@foreach (var adet in new[] { 10, 25, 50, 100 }) { <option value="@adet" selected="@(Model.PageSize == adet)">@adet</option> }</select></div>
                <div class="col-12 d-flex justify-content-end gap-2"><button class="btn btn-primary" type="submit">Filtrele</button><a asp-action="BenimMesailerim" class="btn btn-outline-secondary">Temizle</a></div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark"><tr><th>Tarih</th><th>Mesai Türü</th><th>Vardiya</th><th>Gerçek Giriş / Çıkış</th><th>Fazla Mesai</th><th>Durum</th><th>İşlem</th></tr></thead>
                    <tbody>
                    @if (Model.Items.Any())
                    {
                        @foreach (var kayit in Model.Items)
                        {
                            <tr>
                                <td>@kayit.Tarih.ToString("dd.MM.yyyy")</td><td>@kayit.MesaiTuru</td>
                                <td>@kayit.VardiyaBaslangic.ToString("hh\\:mm") - @kayit.VardiyaBitis.ToString("hh\\:mm")</td>
                                <td>@(kayit.GercekGiris.HasValue ? $"{kayit.GercekGiris:hh\\:mm} - {kayit.GercekCikis:hh\\:mm}" : "-")</td>
                                <td class="fw-semibold text-success">@kayit.GosterilecekFazlaMesaiSaati.ToString("N2") saat</td>
                                <td><span class="badge text-bg-@DurumRengi(kayit.Durum)">@DurumMetni(kayit.Durum)</span></td>
                                <td><a asp-action="Details" asp-route-id="@kayit.Id" class="btn btn-sm btn-outline-primary">Detay</a></td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Mesai veya vardiya kaydı bulunamadı.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4"><ul class="pagination justify-content-center mb-0">@for (var sayfa = 1; sayfa <= Model.TotalPages; sayfa++) { <li class="page-item @(sayfa == Model.Page ? "active" : "")"><a class="page-link" asp-route-page="@sayfa" asp-route-pageSize="@Model.PageSize" asp-route-arama="@Model.Arama" asp-route-durum="@Model.Durum" asp-route-mesaiTuru="@Model.MesaiTuru" asp-route-baslangicTarihi="@Model.BaslangicTarihi?.ToString("yyyy-MM-dd")" asp-route-bitisTarihi="@Model.BitisTarihi?.ToString("yyyy-MM-dd")">@sayfa</a></li> }</ul></nav>
            }
        </div>
    </div>
</div>
