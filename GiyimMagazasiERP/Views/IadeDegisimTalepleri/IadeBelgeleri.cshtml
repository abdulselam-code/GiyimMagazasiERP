@model GiyimMagazasiERP.ViewModels.PagedResultViewModel<GiyimMagazasiERP.Models.IadeDegisimTalebi>

@{
    ViewData["Title"] = "İade Belgeleri";

    var baslangicTarihi =
        ViewData["BaslangicTarihi"] as DateTime?;

    var bitisTarihi =
        ViewData["BitisTarihi"] as DateTime?;

    var siraNo = ((Model.Page - 1) * Model.PageSize) + 1;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">İade Belgeleri</h1>
            <p class="text-muted mb-0">
                Tamamlanan iade işlemlerine ait uygulama içi iade
                belgelerini görüntüleyin.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            İade Taleplerine Dön
        </a>
    </div>

    @if (TempData["Basari"] is not null)
    {
        <div class="alert alert-success">@TempData["Basari"]</div>
    }

    @if (TempData["Hata"] is not null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="IadeBelgeleri"
                  method="get"
                  class="row g-3 align-items-end">
                <div class="col-xl-4 col-lg-6">
                    <label for="arama" class="form-label">
                        Belge Ara
                    </label>
                    <input id="arama"
                           name="arama"
                           value="@Model.Arama"
                           class="form-control"
                           placeholder="Belge no, talep no, fatura no, müşteri veya personel" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label for="baslangicTarihi" class="form-label">
                        Başlangıç Tarihi
                    </label>
                    <input id="baslangicTarihi"
                           name="baslangicTarihi"
                           type="date"
                           value="@baslangicTarihi?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-xl-2 col-md-4">
                    <label for="bitisTarihi" class="form-label">
                        Bitiş Tarihi
                    </label>
                    <input id="bitisTarihi"
                           name="bitisTarihi"
                           type="date"
                           value="@bitisTarihi?.ToString("yyyy-MM-dd")"
                           class="form-control" />
                </div>

                <div class="col-xl-1 col-md-4">
                    <label for="pageSize" class="form-label">
                        Kayıt
                    </label>
                    <select id="pageSize"
                            name="pageSize"
                            class="form-select">
                        @foreach (var adet in new[] { 10, 25, 50, 100 })
                        {
                            <option value="@adet"
                                    selected="@(Model.PageSize == adet)">
                                @adet
                            </option>
                        }
                    </select>
                </div>

                <div class="col-xl-3 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary flex-fill">
                        Filtrele
                    </button>

                    <a asp-action="IadeBelgeleri"
                       class="btn btn-outline-secondary flex-fill">
                        Temizle
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                <p class="text-muted mb-0">
                    Toplam <strong>@Model.TotalCount</strong>
                    iade belgesi bulundu.
                </p>

                @if (Model.TotalPages > 0)
                {
                    <span class="small text-muted">
                        Sayfa @Model.Page / @Model.TotalPages
                    </span>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>İade Belge No</th>
                            <th>Talep No</th>
                            <th>Tamamlanma Tarihi</th>
                            <th>Kaynak Fatura</th>
                            <th>Satış No</th>
                            <th>Müşteri</th>
                            <th>Talep Eden</th>
                            <th>Muhasebe Onaylayan</th>
                            <th class="text-end">Toplam İade</th>
                            <th>Finans</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var talep in Model.Items)
                            {
                                var talepEden =
                                    talep.TalepEdenPersonel?.AdSoyad
                                    ?? talep.TalepEdenKullanici?.AdSoyad
                                    ?? talep.TalepEdenKullanici?.KullaniciAdi
                                    ?? "-";

                                var muhasebeOnaylayan =
                                    talep.MuhasebeOnaylayanKullanici?.AdSoyad
                                    ?? talep.MuhasebeOnaylayanKullanici?.KullaniciAdi
                                    ?? "-";

                                var tamamlanmaTarihi =
                                    talep.TamamlanmaTarihi
                                    ?? talep.TalepTarihi;

                                <tr>
                                    <td>@siraNo</td>
                                    <td class="fw-bold text-nowrap">
                                        @talep.IadeBelgeNo
                                    </td>
                                    <td class="text-nowrap">
                                        @talep.TalepNo
                                    </td>
                                    <td class="text-nowrap">
                                        @tamamlanmaTarihi.ToString(
                                            "dd.MM.yyyy HH:mm")
                                    </td>
                                    <td class="text-nowrap">
                                        @(string.IsNullOrWhiteSpace(
                                            talep.Satis?.FaturaNo)
                                            ? "-"
                                            : talep.Satis.FaturaNo)
                                    </td>
                                    <td class="text-nowrap">
                                        #@talep.SatisId
                                    </td>
                                    <td>
                                        @(talep.Musteri?.AdSoyad
                                            ?? "Nihai Tüketici")
                                    </td>
                                    <td>@talepEden</td>
                                    <td>@muhasebeOnaylayan</td>
                                    <td class="text-end fw-bold text-nowrap">
                                        @talep.ToplamIadeTutari.ToString("N2") TL
                                    </td>
                                    <td>
                                        @if (talep.FinansHareketiId.HasValue)
                                        {
                                            <span class="badge text-bg-success">
                                                Finans Kaydı Var
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">
                                                Yok
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="Belge"
                                               asp-route-id="@talep.Id"
                                               class="btn btn-sm btn-primary text-nowrap">
                                                Belge Görüntüle
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@talep.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                Detay
                                            </a>
                                        </div>
                                    </td>
                                </tr>

                                siraNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="12"
                                    class="text-center text-muted py-5">
                                    Arama kriterlerine uygun iade belgesi
                                    bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3"
                     aria-label="İade belgeleri sayfalama">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(
                            !Model.OncekiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="IadeBelgeleri"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-baslangicTarihi="@baslangicTarihi?.ToString("yyyy-MM-dd")"
                               asp-route-bitisTarihi="@bitisTarihi?.ToString("yyyy-MM-dd")">
                                Önceki
                            </a>
                        </li>

                        @for (var sayfa = 1;
                            sayfa <= Model.TotalPages;
                            sayfa++)
                        {
                            <li class="page-item @(
                                sayfa == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="IadeBelgeleri"
                                   asp-route-page="@sayfa"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-arama="@Model.Arama"
                                   asp-route-baslangicTarihi="@baslangicTarihi?.ToString("yyyy-MM-dd")"
                                   asp-route-bitisTarihi="@bitisTarihi?.ToString("yyyy-MM-dd")">
                                    @sayfa
                                </a>
                            </li>
                        }

                        <li class="page-item @(
                            !Model.SonrakiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="IadeBelgeleri"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-baslangicTarihi="@baslangicTarihi?.ToString("yyyy-MM-dd")"
                               asp-route-bitisTarihi="@bitisTarihi?.ToString("yyyy-MM-dd")">
                                Sonraki
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
