@model GiyimMagazasiERP.ViewModels.PersonelIzniListeViewModel
@using GiyimMagazasiERP.Models

@{
    ViewData["Title"] = "Benim İzin Taleplerim";
    var izinleriYonetebilir =
        User.IsInRole("Admin") ||
        User.IsInRole("Yonetici") ||
        User.IsInRole("InsanKaynaklari");

    string DurumMetni(string durum) => durum switch
    {
        PersonelIzni.DurumOnayBekliyor => "Onay Bekliyor",
        PersonelIzni.DurumOnaylandi => "Onaylandı",
        PersonelIzni.DurumReddedildi => "Reddedildi",
        PersonelIzni.DurumIptalEdildi => "İptal Edildi",
        _ => durum
    };

    string DurumRengi(string durum) => durum switch
    {
        PersonelIzni.DurumOnayBekliyor => "warning",
        PersonelIzni.DurumOnaylandi => "success",
        PersonelIzni.DurumReddedildi => "danger",
        PersonelIzni.DurumIptalEdildi => "secondary",
        _ => "secondary"
    };
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Benim İzin Taleplerim</h1>
            <p class="text-muted mb-0">
                Bu ekran kendi personel kaydınıza ait izin taleplerini gösterir.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            @if (izinleriYonetebilir)
            {
                <a asp-controller="PersonelIzinleri"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Tüm İzinlere Dön
                </a>
            }

            <a asp-action="Create" class="btn btn-primary">
                Yeni İzin Talebi
            </a>
        </div>
    </div>

    @if (izinleriYonetebilir)
    {
        <div class="alert alert-info">
            Başka personeller adına oluşturduğunuz izinleri görmek için
            <a asp-action="Index" class="alert-link">Tüm İzinler</a>
            ekranını kullanın.
        </div>
    }

    @if (TempData["Basari"] is not null)
    {
        <div class="alert alert-success">@TempData["Basari"]</div>
    }
    @if (TempData["Hata"] is not null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }
    @if (!Model.PersonelEslesmesiVarMi)
    {
        <div class="alert alert-warning">
            Bu kullanıcıya bağlı personel kaydı bulunamadı. İzin talebi oluşturmak için sistem yöneticinizle görüşünüz.
        </div>
    }

    @if (Model.IzinBakiyesi is not null)
    {
        var bakiye = Model.IzinBakiyesi;
        var bakiyeRengi = bakiye.KalanIzinGunu > 5
            ? "success"
            : bakiye.KalanIzinGunu > 0
                ? "warning"
                : "danger";

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="h5 fw-bold mb-1">Yıllık İzin Bakiyem</h2>
                        <p class="text-muted mb-0">@bakiye.Yil yılı izin durumu</p>
                    </div>
                    <span class="badge text-bg-@bakiyeRengi fs-6">
                        @bakiye.KalanIzinGunu.ToString("N2") gün kaldı
                    </span>
                </div>
                <div class="row g-3">
                    <div class="col-sm-6 col-xl">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Yıllık Hak</div>
                            <strong class="fs-5">@bakiye.YillikIzinHakki.ToString("N2") gün</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Devreden</div>
                            <strong class="fs-5">@bakiye.DevredenIzinGunu.ToString("N2") gün</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Kullanılan Yıllık İzin</div>
                            <strong class="fs-5">@bakiye.KullanilanIzinGunu.ToString("N2") gün</strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="border border-@bakiyeRengi rounded p-3">
                            <div class="text-muted small">Kalan Yıllık İzin</div>
                            <strong class="fs-5 text-@bakiyeRengi">
                                @bakiye.KalanIzinGunu.ToString("N2") gün
                            </strong>
                        </div>
                    </div>
                    <div class="col-sm-6 col-xl">
                        <div class="border rounded p-3">
                            <div class="text-muted small">Diğer Onaylı İzinler</div>
                            <strong class="fs-5 text-secondary">
                                @bakiye.DigerOnayliIzinGunu.ToString("N2") gün
                            </strong>
                        </div>
                    </div>
                </div>
                <div class="alert alert-light border mt-3 mb-0 py-2">
                    Yıllık izin bakiyesinden yalnızca onaylanmış yıllık izinler düşülür.
                    Hastalık, mazeret, ücretsiz, doğum ve diğer izinler ayrı gösterilir.
                </div>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-lg-4 col-md-6">
                    <label for="arama" class="form-label">Arama</label>
                    <input id="arama"
                           name="arama"
                           value="@Model.Arama"
                           class="form-control"
                           placeholder="İzin türü veya açıklama" />
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="durum" class="form-label">Durum</label>
                    <select id="durum" name="durum" class="form-select">
                        <option value="Tumu" selected="@(Model.Durum == "Tumu")">Tümü</option>
                        <option value="@PersonelIzni.DurumOnayBekliyor" selected="@(Model.Durum == PersonelIzni.DurumOnayBekliyor)">Onay Bekliyor</option>
                        <option value="@PersonelIzni.DurumOnaylandi" selected="@(Model.Durum == PersonelIzni.DurumOnaylandi)">Onaylandı</option>
                        <option value="@PersonelIzni.DurumReddedildi" selected="@(Model.Durum == PersonelIzni.DurumReddedildi)">Reddedildi</option>
                        <option value="@PersonelIzni.DurumIptalEdildi" selected="@(Model.Durum == PersonelIzni.DurumIptalEdildi)">İptal Edildi</option>
                    </select>
                </div>
                <div class="col-lg-3 col-md-6">
                    <label for="izinTuru" class="form-label">İzin Türü</label>
                    <select id="izinTuru" name="izinTuru" class="form-select">
                        <option value="Tumu">Tümü</option>
                        @foreach (var tur in PersonelIzni.IzinTurleri)
                        {
                            <option value="@tur" selected="@(Model.IzinTuru == tur)">@tur</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label for="pageSize" class="form-label">Kayıt</label>
                    <select id="pageSize" name="pageSize" class="form-select">
                        @foreach (var adet in new[] { 10, 25, 50, 100 })
                        {
                            <option value="@adet" selected="@(Model.PageSize == adet)">@adet</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-primary">Filtrele</button>
                    <a asp-action="BenimIzinlerim" class="btn btn-outline-secondary">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between gap-2 mb-3">
                <span class="text-muted">Toplam <strong>@Model.TotalCount</strong> talep</span>
                <span class="text-muted">Sayfa @Model.Page / @Model.TotalPages</span>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Talep No</th>
                            <th>İzin Türü</th>
                            <th>Tarih Aralığı</th>
                            <th>Gün</th>
                            <th>Durum</th>
                            <th>Oluşturma Tarihi</th>
                            <th>İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var izin in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">#@izin.Id</td>
                                    <td>@izin.IzinTuru</td>
                                    <td>
                                        @izin.BaslangicTarihi.ToString("dd.MM.yyyy")
                                        -
                                        @izin.BitisTarihi.ToString("dd.MM.yyyy")
                                    </td>
                                    <td>@izin.GunSayisi</td>
                                    <td>
                                        <span class="badge text-bg-@DurumRengi(izin.Durum)">
                                            @DurumMetni(izin.Durum)
                                        </span>
                                    </td>
                                    <td>@izin.OlusturmaTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <a asp-action="Details"
                                           asp-route-id="@izin.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Detay
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    Arama kriterlerine uygun izin talebi bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(!Model.OncekiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-route-page="@(Model.Page - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-durum="@Model.Durum"
                               asp-route-izinTuru="@Model.IzinTuru">Önceki</a>
                        </li>
                        @for (var sayfa = Math.Max(1, Model.Page - 2); sayfa <= Math.Min(Model.TotalPages, Model.Page + 2); sayfa++)
                        {
                            <li class="page-item @(sayfa == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-route-page="@sayfa"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-arama="@Model.Arama"
                                   asp-route-durum="@Model.Durum"
                                   asp-route-izinTuru="@Model.IzinTuru">@sayfa</a>
                            </li>
                        }
                        <li class="page-item @(!Model.SonrakiSayfaVarMi ? "disabled" : "")">
                            <a class="page-link"
                               asp-route-page="@(Model.Page + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-arama="@Model.Arama"
                               asp-route-durum="@Model.Durum"
                               asp-route-izinTuru="@Model.IzinTuru">Sonraki</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
