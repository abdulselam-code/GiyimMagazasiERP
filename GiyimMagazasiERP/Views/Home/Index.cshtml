@using System.Security.Claims

@{
    ViewData["Title"] = "Ana Sayfa";

    var girisVarMi = User.Identity?.IsAuthenticated == true;
    var kullaniciAdi = User.Identity?.Name ?? "Kullanıcı";
    var rol = User.FindFirst(ClaimTypes.Role)?.Value ?? "Tanımsız";
}

<div class="container py-4">
    <section class="rounded-4 p-4 p-lg-5 text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #0f172a, #1d4ed8);">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <h1 class="display-6 fw-bold mb-3">
                    Giyim Mağazası ERP ve İşletme Yönetim Sistemi
                </h1>

                <p class="lead mb-0">
                    Satış, stok, müşteri, personel, finans ve raporlama süreçlerini tek panelden yönetin.
                </p>
            </div>

            <div class="col-lg-4">
                <div class="bg-white text-dark rounded-4 p-4 shadow-sm">
                    @if (girisVarMi)
                    {
                        <p class="text-muted mb-1">Hoş geldiniz,</p>
                        <h2 class="h4 fw-bold mb-2">@kullaniciAdi</h2>
                        <p class="mb-3">
                            <span class="text-muted">Rolünüz:</span>
                            <strong>@rol</strong>
                        </p>

                        <a asp-controller="Dashboard"
                           asp-action="Index"
                           class="btn btn-primary w-100">
                            Dashboard'a Git
                        </a>
                    }
                    else
                    {
                        <h2 class="h5 fw-bold mb-2">Devam etmek için giriş yapınız.</h2>
                        <p class="text-muted mb-3">
                            ERP paneline erişmek için kullanıcı hesabınızla oturum açın.
                        </p>

                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-primary w-100">
                            Giriş Yap
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3">
        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 fw-bold">Satış Yönetimi</h2>
                    <p class="text-muted mb-0">
                        Sepetli satış, müşteri takibi ve fatura süreçleri yönetilir.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 fw-bold">Stok Yönetimi</h2>
                    <p class="text-muted mb-0">
                        Ürün, kategori, tedarikçi ve stok hareketleri takip edilir.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 fw-bold">Finans Yönetimi</h2>
                    <p class="text-muted mb-0">
                        Gelir, gider, net kazanç ve işletme giderleri izlenir.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h5 fw-bold">Raporlama</h2>
                    <p class="text-muted mb-0">
                        Günlük, aylık ve yıllık raporlarla işletme performansı analiz edilir.
                    </p>
                </div>
            </div>
        </div>
    </section>
</div>