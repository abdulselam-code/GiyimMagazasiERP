@model GiyimMagazasiERP.Models.Satis

@{
    ViewData["Title"] = "Satış Başarılı";

    var urunSayisi = Model.SatisDetaylari.Count;
    var toplamAdet = Model.SatisDetaylari.Sum(x => x.Adet);

    var kdvDahilGenelToplam = Model.VergiDahilToplam == 0
        ? Model.NetTutar
        : Model.VergiDahilToplam;

    var kdvHaricTutar = Model.VergiHaricToplam;
    var kdvTutari = Model.ToplamKdvTutari;

    var faturaNo = string.IsNullOrWhiteSpace(Model.FaturaNo)
        ? "FAT-" + Model.Id.ToString("D6")
        : Model.FaturaNo;

    var satisTuru = string.IsNullOrWhiteSpace(Model.SatisTuru)
        ? "Perakende"
        : Model.SatisTuru;

    string OdemeTipiGoster(string? odemeTipi)
    {
        return odemeTipi switch
        {
            "KrediKarti" => "Kredi Kartı",
            "BankaKarti" => "Banka Kartı",
            "Nakit" => "Nakit",
            "Havale" => "Havale",
            _ => odemeTipi ?? "-"
        };
    }
}

<div class="container py-4">
    <div class="alert alert-success border-0 shadow-sm">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div>
                <h1 class="h4 fw-bold mb-2">Satış Başarıyla Tamamlandı</h1>
                <p class="mb-0">
                    Satış, stok, finans ve fatura kayıtları sisteme işlendi.
                </p>
            </div>

            <span class="badge text-bg-success px-3 py-2">
                İşlem Tamamlandı
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <h2 class="h5 fw-bold mb-1">Satış Özeti</h2>
                    <p class="text-muted mb-0">
                        Satış sonrası oluşan ürün, ödeme, KDV ve fatura bilgileri.
                    </p>
                </div>

                <span class="badge text-bg-primary px-3 py-2">
                    @satisTuru Satış
                </span>
            </div>

            <div class="row g-4">
                <div class="col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h3 class="h6 fw-bold text-uppercase text-muted mb-3">
                            Satış Bilgileri
                        </h3>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Satış No</dt>
                            <dd class="col-sm-7">#@Model.Id</dd>

                            <dt class="col-sm-5">Fatura No</dt>
                            <dd class="col-sm-7">@faturaNo</dd>

                            <dt class="col-sm-5">Satış Tarihi</dt>
                            <dd class="col-sm-7">
                                @Model.SatisTarihi.ToString("dd/MM/yyyy HH:mm")
                            </dd>

                            <dt class="col-sm-5">Satış Türü</dt>
                            <dd class="col-sm-7">@satisTuru</dd>

                            <dt class="col-sm-5">Ödeme Tipi</dt>
                            <dd class="col-sm-7">
                                @OdemeTipiGoster(Model.OdemeTipi)
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="border rounded-3 p-3 h-100">
                        <h3 class="h6 fw-bold text-uppercase text-muted mb-3">
                            Müşteri / Personel
                        </h3>

                        <dl class="row mb-0">
                            <dt class="col-sm-5">Müşteri</dt>
                            <dd class="col-sm-7">
                                @(Model.Musteri?.AdSoyad ?? "Nihai Tüketici")
                            </dd>

                            <dt class="col-sm-5">Personel / Kasiyer</dt>
                            <dd class="col-sm-7">
                                @(Model.Personel?.AdSoyad ?? "-")
                            </dd>

                            <dt class="col-sm-5">Pozisyon</dt>
                            <dd class="col-sm-7">
                                @(Model.Personel?.Pozisyon ?? "-")
                            </dd>

                            <dt class="col-sm-5">Ürün Kalemi</dt>
                            <dd class="col-sm-7">@urunSayisi</dd>

                            <dt class="col-sm-5">Toplam Adet</dt>
                            <dd class="col-sm-7">@toplamAdet</dd>
                        </dl>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <h3 class="h5 fw-bold mb-3">Satılan Ürünler</h3>

                <div class="table-responsive">
                    <table class="table table-hover table-bordered align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Ürün</th>
                                <th class="text-end">Adet</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">İndirim</th>
                                <th class="text-end">KDV</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var detay in Model.SatisDetaylari)
                            {
                                var urunAdi = !string.IsNullOrWhiteSpace(detay.UrunAdiSnapshot)
                                    ? detay.UrunAdiSnapshot
                                    : detay.Urun?.UrunAdi ?? "-";

                                var barkod = !string.IsNullOrWhiteSpace(detay.BarkodSnapshot)
                                    ? detay.BarkodSnapshot
                                    : detay.Urun?.Barkod ?? "-";

                                var beden = !string.IsNullOrWhiteSpace(detay.BedenSnapshot)
                                    ? detay.BedenSnapshot
                                    : detay.Urun?.Beden ?? "-";

                                var renk = !string.IsNullOrWhiteSpace(detay.RenkSnapshot)
                                    ? detay.RenkSnapshot
                                    : detay.Urun?.Renk ?? "-";

                                var satirTutar = detay.VergiDahilTutar == 0
                                    ? detay.ToplamTutar
                                    : detay.VergiDahilTutar;

                                <tr>
                                    <td>
                                        <div class="fw-semibold">@urunAdi</div>
                                        <div class="small text-muted">
                                            Barkod: @barkod | Beden: @beden | Renk: @renk
                                        </div>
                                    </td>

                                    <td class="text-end">@detay.Adet</td>

                                    <td class="text-end">
                                        @detay.BirimFiyat.ToString("N2") TL
                                    </td>

                                    <td class="text-end">
                                        @detay.SatirIndirimTutari.ToString("N2") TL
                                    </td>

                                    <td class="text-end">
                                        %@detay.KdvOrani.ToString("N2") /
                                        @detay.KdvTutari.ToString("N2") TL
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @satirTutar.ToString("N2") TL
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="row justify-content-end mt-4">
                <div class="col-lg-5">
                    <div class="border rounded-3 p-3 bg-light">
                        <h3 class="h6 fw-bold mb-3">Toplamlar</h3>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>Ara Toplam</span>
                            <strong>@Model.ToplamTutar.ToString("N2") TL</strong>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>Toplam İndirim</span>
                            <strong>@Model.IndirimTutari.ToString("N2") TL</strong>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>KDV Yapısı</span>
                            <strong>Ürün Bazlı</strong>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>KDV Hariç Toplam</span>
                            <strong>@kdvHaricTutar.ToString("N2") TL</strong>
                        </div>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span>Toplam KDV</span>
                            <strong>@kdvTutari.ToString("N2") TL</strong>
                        </div>

                        <div class="d-flex justify-content-between align-items-center py-3 fs-5">
                            <span class="fw-bold">Ödenecek Tutar</span>

                            <strong class="text-success">
                                @kdvDahilGenelToplam.ToString("N2") TL
                            </strong>
                        </div>

                        <p class="small text-muted mb-0">
                            Ürün fiyatları KDV dahil fiyat olarak hesaplanmıştır.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <a asp-action="Create" class="btn btn-success">
                    Yeni Satış Yap
                </a>

                <a asp-controller="Faturalar"
                   asp-action="Detay"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    Faturayı Görüntüle
                </a>

                <a asp-controller="Satislar"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Satışlara Dön
                </a>

                <a asp-controller="Faturalar"
                   asp-action="Index"
                   class="btn btn-outline-primary">
                    Faturalar Listesine Git
                </a>
            </div>
        </div>
    </div>
</div>