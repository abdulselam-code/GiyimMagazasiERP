@model GiyimMagazasiERP.ViewModels.SatisOlusturViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Satış Yap";

    var urunFiyatlariJson = JsonSerializer.Serialize(ViewData["UrunFiyatlari"]);
    var urunStoklariJson = JsonSerializer.Serialize(ViewData["UrunStoklari"]);
    var musteriIndirimOranlariJson = JsonSerializer.Serialize(ViewData["MusteriIndirimOranlari"]);
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1">Satış Yap</h1>
        <p class="text-muted mb-0">
            Tek ürünlü satış işlemi ile stok, finans ve müşteri bilgileri otomatik güncellenir.
        </p>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MusteriId" class="form-label">Müşteri</label>
                                <select asp-for="MusteriId"
                                        asp-items="ViewBag.MusteriId"
                                        class="form-select"
                                        id="musteriSecimi">
                                    <option value="">Kayıtsız Müşteri</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PersonelId" class="form-label">Satışı Yapan Personel</label>
                                <select asp-for="PersonelId"
                                        asp-items="ViewBag.PersonelId"
                                        class="form-select">
                                    <option value="">Personel Seçiniz</option>
                                </select>
                                <span asp-validation-for="PersonelId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="UrunId" class="form-label">Ürün</label>
                                <select asp-for="UrunId"
                                        asp-items="ViewBag.UrunId"
                                        class="form-select"
                                        id="urunSecimi">
                                    <option value="">Ürün Seçiniz</option>
                                </select>
                                <span asp-validation-for="UrunId" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Adet" class="form-label">Adet</label>
                                <input asp-for="Adet"
                                       class="form-control"
                                       min="1"
                                       id="adetGirisi" />
                                <span asp-validation-for="Adet" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="OdemeTipi" class="form-label">Ödeme Tipi</label>
                                <select asp-for="OdemeTipi"
                                        asp-items="ViewBag.OdemeTipleri"
                                        class="form-select">
                                    <option value="">Ödeme Tipi Seçiniz</option>
                                </select>
                                <span asp-validation-for="OdemeTipi" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">KDV Bilgisi</label>
                                <div class="form-control bg-light">
                                    Fiyatlara %20 KDV dahildir
                                </div>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn btn-success">
                                Satışı Tamamla
                            </button>

                            <a asp-controller="Satislar"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Satış Listesine Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h2 class="h5 fw-bold">ERP İşlem Akışı</h2>

                    <ul class="mb-0">
                        <li>Satış kaydı oluşturulur.</li>
                        <li>Satış detayı kaydedilir.</li>
                        <li>Ürün stoğu düşer.</li>
                        <li>Stok hareketi oluşur.</li>
                        <li>Finans geliri oluşur.</li>
                        <li>Müşteri harcaması güncellenir.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                        <div>
                            <h2 class="h5 fw-bold mb-1">Satış Özeti</h2>
                            <p class="text-muted small mb-0">
                                Seçilen ürün ve müşteri bilgisine göre anlık hesaplanır.
                            </p>
                        </div>

                        <span class="badge text-bg-primary">
                            KDV Dahil
                        </span>
                    </div>

                    <div class="alert alert-info small mb-3">
                        Ürün satış fiyatları KDV dahil kabul edilir. KDV ayrıca eklenmez.
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Ürün Fiyatı</span>
                        <strong id="ozetUrunFiyati">0,00 TL</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Adet</span>
                        <strong id="ozetAdet">1</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Mevcut Stok</span>
                        <strong id="ozetStok">-</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>Ara Toplam</span>
                        <strong id="ozetAraToplam">0,00 TL</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>İndirim Oranı</span>
                        <strong id="ozetIndirimOrani">%0</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>İndirim Tutarı</span>
                        <strong id="ozetIndirimTutari">0,00 TL</strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                        <span class="fw-bold">KDV Dahil Genel Toplam</span>
                        <strong class="fs-5 text-success" id="ozetGenelToplam">
                            0,00 TL
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>KDV Oranı</span>
                        <strong>%20</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span>KDV Hariç Tutar</span>
                        <strong id="ozetKdvHaricTutar">0,00 TL</strong>
                    </div>

                    <div class="d-flex justify-content-between py-2">
                        <span>KDV Tutarı</span>
                        <strong id="ozetKdvTutari">0,00 TL</strong>
                    </div>

                    <p class="small text-muted mt-3 mb-0">
                        Genel toplam KDV dahildir ve satış kaydındaki Net Tutar ile aynı mantıkta hesaplanır.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const urunFiyatlari = @Html.Raw(urunFiyatlariJson);
        const urunStoklari = @Html.Raw(urunStoklariJson);
        const musteriIndirimOranlari = @Html.Raw(musteriIndirimOranlariJson);

        const kdvCarpani = 1.20;

        const urunSecimi = document.getElementById("urunSecimi");
        const musteriSecimi = document.getElementById("musteriSecimi");
        const adetGirisi = document.getElementById("adetGirisi");

        const ozetUrunFiyati = document.getElementById("ozetUrunFiyati");
        const ozetAdet = document.getElementById("ozetAdet");
        const ozetStok = document.getElementById("ozetStok");
        const ozetAraToplam = document.getElementById("ozetAraToplam");
        const ozetIndirimOrani = document.getElementById("ozetIndirimOrani");
        const ozetIndirimTutari = document.getElementById("ozetIndirimTutari");
        const ozetGenelToplam = document.getElementById("ozetGenelToplam");
        const ozetKdvHaricTutar = document.getElementById("ozetKdvHaricTutar");
        const ozetKdvTutari = document.getElementById("ozetKdvTutari");

        function tlFormatla(tutar) {
            return new Intl.NumberFormat("tr-TR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }).format(tutar) + " TL";
        }

        function oranFormatla(oran) {
            return "%" + new Intl.NumberFormat("tr-TR", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            }).format(oran);
        }

        function sayiyaCevir(deger) {
            const sayi = Number(deger);
            return Number.isFinite(sayi) ? sayi : 0;
        }

        function satisOzetiniGuncelle() {
            const urunId = urunSecimi.value;
            const musteriId = musteriSecimi.value;

            const urunFiyati = sayiyaCevir(urunFiyatlari[urunId]);
            const stokMiktari = urunId && urunStoklari[urunId] !== undefined
                ? sayiyaCevir(urunStoklari[urunId])
                : null;

            let adet = parseInt(adetGirisi.value);

            if (!Number.isFinite(adet) || adet < 1) {
                adet = 1;
            }

            const indirimOrani = musteriId && musteriIndirimOranlari[musteriId] !== undefined
                ? sayiyaCevir(musteriIndirimOranlari[musteriId])
                : 0;

            const araToplam = urunFiyati * adet;
            const indirimTutari = araToplam * indirimOrani / 100;
            const kdvDahilGenelToplam = araToplam - indirimTutari;
            const kdvHaricTutar = kdvDahilGenelToplam / kdvCarpani;
            const kdvTutari = kdvDahilGenelToplam - kdvHaricTutar;

            ozetUrunFiyati.textContent = tlFormatla(urunFiyati);
            ozetAdet.textContent = adet;
            ozetStok.textContent = stokMiktari === null ? "-" : stokMiktari;
            ozetAraToplam.textContent = tlFormatla(araToplam);
            ozetIndirimOrani.textContent = oranFormatla(indirimOrani);
            ozetIndirimTutari.textContent = tlFormatla(indirimTutari);
            ozetGenelToplam.textContent = tlFormatla(kdvDahilGenelToplam);
            ozetKdvHaricTutar.textContent = tlFormatla(kdvHaricTutar);
            ozetKdvTutari.textContent = tlFormatla(kdvTutari);
        }

        urunSecimi.addEventListener("change", satisOzetiniGuncelle);
        musteriSecimi.addEventListener("change", satisOzetiniGuncelle);
        adetGirisi.addEventListener("input", satisOzetiniGuncelle);

        satisOzetiniGuncelle();
    </script>
}