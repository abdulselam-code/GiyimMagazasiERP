@model GiyimMagazasiERP.ViewModels.SatisOlusturViewModel

@using System.Text.Json

@{
    ViewData["Title"] = "Satış Yap";

    var musterilerJson = JsonSerializer.Serialize(ViewData["MusterilerJson"]);
    var urunlerJson = JsonSerializer.Serialize(ViewData["UrunlerJson"]);
    var mevcutSepetJson = JsonSerializer.Serialize(Model.SepetUrunleri ?? new List<GiyimMagazasiERP.ViewModels.SatisSepetUrunViewModel>());

    var personelOtomatikMi = ViewData["PersonelOtomatikMi"] as bool? ?? false;
    var otomatikPersonelAdi = ViewData["OtomatikPersonelAdi"]?.ToString() ?? "Uygun personel bulunamadı";
    var personelEslesmeVarMi = ViewData["PersonelEslesmeVarMi"] as bool? ?? true;
    var personelHataMesaji = ViewData["PersonelHataMesaji"]?.ToString();
}


<div class="container py-4 sales-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Satış Yap</h1>
            <p class="text-muted mb-0">Perakende veya toptan satış oluşturabilirsiniz.</p>
        </div>

        <span class="badge text-bg-primary px-3 py-2">KDV Dahil</span>
    </div>

    <form asp-action="Create" method="post" id="satisFormu">
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
        }

        <div id="sepetUyariAlani"></div>
        @if (!personelEslesmeVarMi && !string.IsNullOrWhiteSpace(personelHataMesaji))
        {
            <div class="alert alert-warning">
                @personelHataMesaji
            </div>
        }

        <input type="hidden" asp-for="SatisTuru" id="satisTuruInput" />

        <div class="sales-type-tabs mb-4">
            <button type="button" class="sales-type-tab active" data-type="Perakende">
                <strong>Perakende Satış</strong>
                <span>Hızlı mağaza satışı</span>
            </button>

            <button type="button" class="sales-type-tab" data-type="Toptan">
                <strong>Toptan Satış</strong>
                <span>Kurumsal / toplu satış</span>
            </button>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-xl-8">
                <div class="sales-card card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Satış Bilgileri</h2>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MusteriId" class="form-label">Müşteri</label>
                                <select asp-for="MusteriId"
                                        asp-items="ViewBag.MusteriId"
                                        class="form-select"
                                        id="musteriSecimi">
                                    <option value="">Nihai Tüketici / Kayıtsız Müşteri</option>
                                </select>
                                <div class="form-text" id="musteriAciklama">
                                    Perakende satışta müşteri seçimi isteğe bağlıdır.
                                </div>
                            </div>

                            <div class="col-md-6">
                                @if (personelOtomatikMi)
                                {
                                    <label class="form-label">Satışı Yapan</label>
                                    <div class="sales-info-box">
                                        <strong>@otomatikPersonelAdi</strong>

                                        @if (personelEslesmeVarMi)
                                        {
                                            <span>Giriş yapan kasiyerin bağlı personel kaydı kullanılır.</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">
                                                Bu kullanıcıya bağlı satış personeli bulunamadı.
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <label asp-for="PersonelId" class="form-label">Satışı Yapan Personel</label>
                                    <select asp-for="PersonelId"
                                            asp-items="ViewBag.PersonelId"
                                            class="form-select">
                                        <option value="">Personel Seçiniz</option>
                                    </select>
                                    <span asp-validation-for="PersonelId" class="text-danger"></span>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="OdemeTipi" class="form-label">Ödeme Tipi</label>
                                <select asp-for="OdemeTipi"
                                        asp-items="ViewBag.OdemeTipleri"
                                        class="form-select"
                                        id="odemeTipiSecimi">
                                    <option value="">Ödeme Tipi Seçiniz</option>
                                </select>
                                <span asp-validation-for="OdemeTipi" class="text-danger"></span>
                            </div>

                            <div class="col-md-6" id="toptanAciklamaAlani" style="display:none;">
                                <label asp-for="Aciklama" class="form-label">Açıklama</label>
                                <input asp-for="Aciklama"
                                       class="form-control"
                                       placeholder="Toptan satış notu" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="sales-card card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Sepete Ürün Ekle</h2>

                        <div class="row g-3 align-items-end">
                            <div class="col-lg-7">
                                <label for="urunSecimi" class="form-label">Ürün</label>
                                <select id="urunSecimi"
                                        asp-items="ViewBag.UrunId"
                                        class="form-select">
                                    <option value="">Ürün Seçiniz</option>
                                </select>
                            </div>

                            <div class="col-sm-4 col-lg-2">
                                <label for="adetGirisi" class="form-label">Adet</label>
                                <input type="number"
                                       id="adetGirisi"
                                       class="form-control"
                                       min="1"
                                       value="1" />
                            </div>

                            <div class="col-sm-8 col-lg-3">
                                <button type="button"
                                        id="sepeteEkleBtn"
                                        class="btn btn-primary w-100">
                                    Sepete Ekle
                                </button>
                            </div>
                        </div>

                        <div id="urunBilgiAlani" class="sales-product-info mt-3">
                            Ürün seçildiğinde fiyat, stok, beden ve renk bilgisi burada görünür.
                        </div>
                    </div>
                </div>

                <section class="sales-card card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                            <div>
                                <h2 class="h5 fw-bold mb-1">Sepet</h2>
                                <p class="text-muted mb-0">Satışa eklenecek ürün kalemleri</p>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 cart-table">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Barkod</th>
                                        <th>Beden</th>
                                        <th>Renk</th>
                                        <th class="text-end">Birim Fiyat</th>
                                        <th class="text-end">Adet</th>
                                        <th class="text-end">Ara Toplam</th>
                                        <th class="text-end">İndirim</th>
                                        <th class="text-end">KDV Dahil Toplam</th>
                                        <th class="text-end">Stok</th>
                                        <th>İşlem</th>
                                    </tr>
                                </thead>

                                <tbody id="sepetTabloGovdesi">
                                    <tr>
                                        <td colspan="11" class="text-center text-muted py-4">
                                            Sepette ürün bulunmuyor.
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <div id="sepetHiddenAlanlari"></div>
                    </div>
                </section>
            </div>

            <div class="col-xl-4">
                <div class="sales-summary-card card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h2 class="h5 fw-bold mb-1">Satış Özeti</h2>
                                <p class="text-muted small mb-0">Anlık toplamlar</p>
                            </div>

                            <span class="badge text-bg-info">KDV Dahil</span>
                        </div>

                        <div class="summary-row">
                            <span>Satış Türü</span>
                            <strong id="ozetSatisTuru">Perakende</strong>
                        </div>

                        <div class="summary-row">
                            <span>Ürün Sayısı</span>
                            <strong id="ozetUrunSayisi">0</strong>
                        </div>

                        <div class="summary-row">
                            <span>Toplam Adet</span>
                            <strong id="ozetToplamAdet">0</strong>
                        </div>

                        <div class="summary-row">
                            <span>Ara Toplam</span>
                            <strong id="ozetAraToplam">0,00 TL</strong>
                        </div>

                        <div class="summary-row">
                            <span>İndirim Oranı</span>
                            <strong id="ozetIndirimOrani">%0</strong>
                        </div>

                        <div class="summary-row">
                            <span>İndirim Tutarı</span>
                            <strong id="ozetIndirimTutari">0,00 TL</strong>
                        </div>

                        <div class="summary-row">
                            <span>KDV Oranı</span>
                            <strong>%20</strong>
                        </div>

                        <div class="summary-row">
                            <span>KDV Hariç Tutar</span>
                            <strong id="ozetKdvHaricTutar">0,00 TL</strong>
                        </div>

                        <div class="summary-row">
                            <span>KDV Tutarı</span>
                            <strong id="ozetKdvTutari">0,00 TL</strong>
                        </div>

                        <div class="total-box mt-3">
                            <span>Genel Toplam</span>
                            <strong id="ozetGenelToplam" class="total-amount">0,00 TL</strong>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit"
                                    class="btn btn-success btn-lg"
                                    disabled="@(!personelEslesmeVarMi)">
                                Satışı Tamamla
                            </button>

                            <a asp-controller="Satislar"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Satış Listesine Dön
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

<script type="application/json" id="musterilerJson">@Html.Raw(musterilerJson)</script>
<script type="application/json" id="urunlerJson">@Html.Raw(urunlerJson)</script>
<script type="application/json" id="mevcutSepetJson">@Html.Raw(mevcutSepetJson)</script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const musteriler = JSON.parse(document.getElementById("musterilerJson").textContent || "[]");
        const urunler = JSON.parse(document.getElementById("urunlerJson").textContent || "[]");
        const mevcutSepet = JSON.parse(document.getElementById("mevcutSepetJson").textContent || "[]");

        const kdvCarpani = 1.20;

        const satisTuruInput = document.getElementById("satisTuruInput");
        const satisTuruButonlari = document.querySelectorAll(".sales-type-tab");
        const musteriSecimi = document.getElementById("musteriSecimi");
        const musteriAciklama = document.getElementById("musteriAciklama");
        const odemeTipiSecimi = document.getElementById("odemeTipiSecimi");
        const urunSecimi = document.getElementById("urunSecimi");
        const adetGirisi = document.getElementById("adetGirisi");
        const sepeteEkleBtn = document.getElementById("sepeteEkleBtn");
        const satisFormu = document.getElementById("satisFormu");
        const sepetTabloGovdesi = document.getElementById("sepetTabloGovdesi");
        const sepetHiddenAlanlari = document.getElementById("sepetHiddenAlanlari");
        const sepetUyariAlani = document.getElementById("sepetUyariAlani");
        const urunBilgiAlani = document.getElementById("urunBilgiAlani");
        const toptanAciklamaAlani = document.getElementById("toptanAciklamaAlani");

        const ozetSatisTuru = document.getElementById("ozetSatisTuru");
        const ozetUrunSayisi = document.getElementById("ozetUrunSayisi");
        const ozetToplamAdet = document.getElementById("ozetToplamAdet");
        const ozetAraToplam = document.getElementById("ozetAraToplam");
        const ozetIndirimOrani = document.getElementById("ozetIndirimOrani");
        const ozetIndirimTutari = document.getElementById("ozetIndirimTutari");
        const ozetGenelToplam = document.getElementById("ozetGenelToplam");
        const ozetKdvHaricTutar = document.getElementById("ozetKdvHaricTutar");
        const ozetKdvTutari = document.getElementById("ozetKdvTutari");

        let sepet = Array.isArray(mevcutSepet) ? mevcutSepet.map(x => ({
        UrunId: Number(x.UrunId),
        UrunAdi: x.UrunAdi || "",
        Barkod: x.Barkod || "",
        Beden: x.Beden || "",
        Renk: x.Renk || "",
        BirimFiyat: Number(x.BirimFiyat) || 0,
        Adet: Number(x.Adet) || 1,
        StokMiktari: Number(x.StokMiktari) || 0
        })) : [];

        function tlFormatla(tutar) {
        return new Intl.NumberFormat("tr-TR", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
        }).format(Math.max(0, tutar)) + " TL";
        }

        function oranFormatla(oran) {
        return "%" + new Intl.NumberFormat("tr-TR", {
        minimumFractionDigits: 0,
        maximumFractionDigits: 2
        }).format(Math.max(0, oran));
        }

        function uyariGoster(mesaj, tur) {
        const alertTuru = tur || "danger";
        sepetUyariAlani.innerHTML =
        '<div class="alert alert-' + alertTuru + ' alert-dismissible fade show" role="alert">' +
        mesaj +
        '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>' +
        '</div>';
        }

        function htmlGuvenliYaz(deger) {
        const alan = document.createElement("div");
        alan.textContent = deger || "";
        return alan.innerHTML;
        }

        function seciliMusteriIndirimOraniGetir() {
        const musteriId = Number(musteriSecimi.value);
        const musteri = musteriler.find(x => Number(x.Id) === musteriId);
        return musteri ? Number(musteri.IndirimOrani) || 0 : 0;
        }

        function urunuGetir(urunId) {
        return urunler.find(x => Number(x.Id) === Number(urunId));
        }

        function satisTuruAyarla(tur) {
        satisTuruInput.value = tur;
        ozetSatisTuru.textContent = tur;

        satisTuruButonlari.forEach(btn => {
        btn.classList.toggle("active", btn.dataset.type === tur);
        });

        if (tur === "Toptan") {
        musteriAciklama.textContent = "Toptan satışta müşteri seçimi zorunludur.";
        toptanAciklamaAlani.style.display = "";
        } else {
        musteriAciklama.textContent = "Perakende satışta müşteri seçimi isteğe bağlıdır.";
        toptanAciklamaAlani.style.display = "none";
        }

        sepetiGuncelle();
        }

        function urunBilgisiniGuncelle() {
        const urun = urunuGetir(urunSecimi.value);

        if (!urun) {
        urunBilgiAlani.textContent = "Ürün seçildiğinde fiyat, stok, beden ve renk bilgisi burada görünür.";
        return;
        }

        urunBilgiAlani.innerHTML =
        '<strong>' + htmlGuvenliYaz(urun.UrunAdi) + '</strong>' +
        '<span>Fiyat: ' + tlFormatla(Number(urun.SatisFiyati) || 0) + '</span>' +
        '<span>Stok: ' + (Number(urun.StokMiktari) || 0) + '</span>' +
        '<span>Beden: ' + htmlGuvenliYaz(urun.Beden) + '</span>' +
        '<span>Renk: ' + htmlGuvenliYaz(urun.Renk) + '</span>';
        }

        function sepeteUrunEkle() {
        const urunId = Number(urunSecimi.value);
        const adet = Number(adetGirisi.value);

        if (!urunId) {
        uyariGoster("Sepete eklemek için ürün seçiniz.");
        return;
        }

        if (!Number.isInteger(adet) || adet < 1) {
        uyariGoster("Ürün adedi en az 1 olmalıdır.");
        return;
        }

        const urun = urunuGetir(urunId);

        if (!urun) {
        uyariGoster("Seçilen ürün bulunamadı.");
        return;
        }

        const mevcutSatir = sepet.find(x => x.UrunId === urunId);
        const mevcutAdet = mevcutSatir ? mevcutSatir.Adet : 0;
        const yeniToplamAdet = mevcutAdet + adet;
        const stokMiktari = Number(urun.StokMiktari) || 0;

        if (yeniToplamAdet > stokMiktari) {
        uyariGoster("Seçilen ürün için yeterli stok yok.");
        return;
        }

        if (mevcutSatir) {
        mevcutSatir.Adet = yeniToplamAdet;
        } else {
        sepet.push({
        UrunId: Number(urun.Id),
        UrunAdi: urun.UrunAdi || "",
        Barkod: urun.Barkod || "",
        Beden: urun.Beden || "",
        Renk: urun.Renk || "",
        BirimFiyat: Number(urun.SatisFiyati) || 0,
        Adet: adet,
        StokMiktari: stokMiktari
        });
        }

        urunSecimi.value = "";
        adetGirisi.value = 1;
        urunBilgisiniGuncelle();

        uyariGoster("Ürün sepete eklendi.", "success");
        sepetiGuncelle();
        }

        function sepettenCikar(index) {
        sepet.splice(index, 1);
        sepetiGuncelle();
        }

        window.sepettenCikar = sepettenCikar;

        function hiddenInputEkle(index, alan, deger) {
        const input = document.createElement("input");
        input.type = "hidden";
        input.name = "SepetUrunleri[" + index + "]." + alan;
        input.value = deger || "";
        sepetHiddenAlanlari.appendChild(input);
        }

        function sepetiGuncelle() {
        const indirimOrani = seciliMusteriIndirimOraniGetir();

        sepetTabloGovdesi.innerHTML = "";
        sepetHiddenAlanlari.innerHTML = "";

        let toplamAdet = 0;
        let araToplam = 0;
        let indirimTutari = 0;
        let genelToplam = 0;

        if (sepet.length === 0) {
        sepetTabloGovdesi.innerHTML =
        '<tr><td colspan="11" class="text-center text-muted py-4">Sepette ürün bulunmuyor.</td></tr>';
        }

        sepet.forEach((urun, index) => {
        const satirAraToplam = urun.BirimFiyat * urun.Adet;
        const satirIndirim = satirAraToplam * indirimOrani / 100;
        const satirKdvDahilToplam = satirAraToplam - satirIndirim;

        toplamAdet += urun.Adet;
        araToplam += satirAraToplam;
        indirimTutari += satirIndirim;
        genelToplam += satirKdvDahilToplam;

        sepetTabloGovdesi.innerHTML +=
        '<tr>' +
        '<td class="fw-semibold">' + htmlGuvenliYaz(urun.UrunAdi) + '</td>' +
        '<td>' + htmlGuvenliYaz(urun.Barkod) + '</td>' +
        '<td>' + htmlGuvenliYaz(urun.Beden) + '</td>' +
        '<td>' + htmlGuvenliYaz(urun.Renk) + '</td>' +
        '<td class="text-end">' + tlFormatla(urun.BirimFiyat) + '</td>' +
        '<td class="text-end">' + urun.Adet + '</td>' +
        '<td class="text-end">' + tlFormatla(satirAraToplam) + '</td>' +
        '<td class="text-end">' + tlFormatla(satirIndirim) + '</td>' +
        '<td class="text-end fw-semibold text-success">' + tlFormatla(satirKdvDahilToplam) + '</td>' +
        '<td class="text-end">' + urun.StokMiktari + '</td>' +
        '<td><button type="button" class="btn btn-sm btn-outline-danger" onclick="sepettenCikar(' + index + ')">Çıkar</button></td>' +
        '</tr>';

        hiddenInputEkle(index, "UrunId", urun.UrunId);
        hiddenInputEkle(index, "UrunAdi", urun.UrunAdi);
        hiddenInputEkle(index, "Barkod", urun.Barkod);
        hiddenInputEkle(index, "Beden", urun.Beden);
        hiddenInputEkle(index, "Renk", urun.Renk);
        hiddenInputEkle(index, "BirimFiyat", urun.BirimFiyat);
        hiddenInputEkle(index, "Adet", urun.Adet);
        hiddenInputEkle(index, "StokMiktari", urun.StokMiktari);
        });

        const kdvHaricTutar = genelToplam / kdvCarpani;
        const kdvTutari = genelToplam - kdvHaricTutar;

        ozetUrunSayisi.textContent = sepet.length;
        ozetToplamAdet.textContent = toplamAdet;
        ozetAraToplam.textContent = tlFormatla(araToplam);
        ozetIndirimOrani.textContent = oranFormatla(indirimOrani);
        ozetIndirimTutari.textContent = tlFormatla(indirimTutari);
        ozetGenelToplam.textContent = tlFormatla(genelToplam);
        ozetKdvHaricTutar.textContent = tlFormatla(kdvHaricTutar);
        ozetKdvTutari.textContent = tlFormatla(kdvTutari);
        }

        satisTuruButonlari.forEach(btn => {
        btn.addEventListener("click", function () {
        satisTuruAyarla(btn.dataset.type);
        });
        });

        urunSecimi.addEventListener("change", urunBilgisiniGuncelle);
        sepeteEkleBtn.addEventListener("click", sepeteUrunEkle);
        musteriSecimi.addEventListener("change", sepetiGuncelle);

        satisFormu.addEventListener("submit", function (event) {
        if (satisTuruInput.value === "Toptan" && !musteriSecimi.value) {
        event.preventDefault();
        uyariGoster("Toptan satış için müşteri seçilmelidir.");
        return;
        }

        if (!odemeTipiSecimi.value) {
        event.preventDefault();
        uyariGoster("Ödeme tipi seçilmelidir.");
        return;
        }

        if (sepet.length === 0) {
        event.preventDefault();
        uyariGoster("Satış tamamlamak için sepete en az bir ürün eklenmelidir.");
        }
        });

        satisTuruAyarla(satisTuruInput.value || "Perakende");
        urunBilgisiniGuncelle();
        sepetiGuncelle();
    </script>
}