@model GiyimMagazasiERP.ViewModels.DepoSiparisTalebiListeViewModel
@using GiyimMagazasiERP.Models
@{ViewData["Title"]="Depo Ürün Sipariş Talepleri"; string D(string x)=>x switch{DepoSiparisTalebi.DurumOnayBekliyor=>"Onay Bekliyor",DepoSiparisTalebi.DurumOnaylandi=>"Onaylandı",DepoSiparisTalebi.DurumReddedildi=>"Reddedildi",DepoSiparisTalebi.DurumIptalEdildi=>"İptal Edildi",DepoSiparisTalebi.DurumTeslimAlindi=>"Teslim Alındı",_=>x}; string R(string x)=>x switch{DepoSiparisTalebi.DurumOnayBekliyor=>"warning",DepoSiparisTalebi.DurumOnaylandi=>"info",DepoSiparisTalebi.DurumTeslimAlindi=>"success",DepoSiparisTalebi.DurumReddedildi=>"danger",_=>"secondary"};}
<div class="container-fluid px-3 px-lg-4 py-4">
<div class="d-flex justify-content-between flex-wrap gap-3 mb-4"><div><h1 class="h3 fw-bold mb-1">Depo Ürün Sipariş Talepleri</h1><p class="text-muted mb-0">Stok tamamlama taleplerini ve teslim süreçlerini yönetin.</p></div>@if(!User.IsInRole("Muhasebe")){<a asp-action="Create" class="btn btn-primary">Yeni Ürün Sipariş Talebi</a>}</div>
@if(TempData["Basari"] is not null){<div class="alert alert-success">@TempData["Basari"]</div>}@if(TempData["Hata"] is not null){<div class="alert alert-danger">@TempData["Hata"]</div>}
<div class="row g-3 mb-4">@foreach(var k in new[]{("Onay Bekleyen",Model.Ozet.OnayBekleyen,"warning"),("Onaylanan",Model.Ozet.Onaylanan,"info"),("Teslim Alınan",Model.Ozet.TeslimAlinan,"success"),("Kritik Öncelikli",Model.Ozet.KritikOncelikli,"danger")}){<div class="col-sm-6 col-xl-3"><div class="card border-0 border-start border-4 border-@k.Item3 shadow-sm"><div class="card-body"><div class="small text-muted">@k.Item1</div><strong class="fs-4 text-@k.Item3">@k.Item2</strong></div></div></div>}</div>
<div class="card border-0 shadow-sm mb-4"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-lg-3"><label class="form-label">Arama</label><input name="arama" value="@Model.Arama" class="form-control" placeholder="Talep no, kullanıcı veya ürün"/></div><div class="col-lg-2"><label class="form-label">Durum</label><select name="durum" class="form-select"><option value="Tumu">Tümü</option>@foreach(var d in new[]{DepoSiparisTalebi.DurumOnayBekliyor,DepoSiparisTalebi.DurumOnaylandi,DepoSiparisTalebi.DurumReddedildi,DepoSiparisTalebi.DurumIptalEdildi,DepoSiparisTalebi.DurumTeslimAlindi}){<option value="@d" selected="@(Model.Durum==d)">@D(d)</option>}</select></div><div class="col-lg-2"><label class="form-label">Öncelik</label><select name="oncelik" class="form-select"><option value="Tumu">Tümü</option>@foreach(var o in DepoSiparisTalebi.Oncelikler){<option value="@o" selected="@(Model.Oncelik==o)">@o</option>}</select></div><div class="col-lg-2"><label class="form-label">Ürün</label><select name="urunId" asp-items="Model.Urunler" class="form-select"><option value="">Tümü</option></select></div><div class="col-lg-1"><label class="form-label">Kayıt</label><select name="pageSize" class="form-select">@foreach(var n in new[]{10,25,50,100}){<option value="@n" selected="@(Model.PageSize==n)">@n</option>}</select></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary">Filtrele</button><a asp-action="Index" class="btn btn-outline-secondary">Temizle</a></div></form></div></div>
<div class="card border-0 shadow-sm"><div class="card-body"><div class="table-responsive"><table class="table table-hover align-middle"><thead class="table-dark"><tr><th>Talep No</th><th>Tarih</th><th>Talep Eden</th><th>Ürün</th><th>Toplam Adet</th><th>Öncelik</th><th>Durum</th><th>İşlem</th></tr></thead><tbody>@if(Model.Items.Any()){foreach(var x in Model.Items){<tr><td class="fw-semibold">@x.TalepNo</td><td>@x.TalepTarihi.ToString("dd.MM.yyyy HH:mm")</td><td>@(x.TalepEdenPersonel?.AdSoyad??x.TalepEdenKullanici.KullaniciAdi)</td><td>@x.Kalemler.Count</td><td>@x.Kalemler.Sum(k=>k.TalepAdedi)</td><td><span class="badge text-bg-@(x.Oncelik=="Kritik"?"danger":x.Oncelik=="Yuksek"?"warning":"secondary")">@x.Oncelik</span></td><td><span class="badge text-bg-@R(x.Durum)">@D(x.Durum)</span></td><td><a asp-action="Details" asp-route-id="@x.Id" class="btn btn-sm btn-outline-primary">Detay</a></td></tr>}}else{<tr><td colspan="8" class="text-center text-muted py-4">Talep bulunamadı.</td></tr>}</tbody></table></div></div></div>
</div>
