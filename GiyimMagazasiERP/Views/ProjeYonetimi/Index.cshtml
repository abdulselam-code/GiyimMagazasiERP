@model GiyimMagazasiERP.ViewModels.ProjeYonetimiDashboardViewModel
@{
    ViewData["Title"] = "Proje Yönetimi";
    var proje = Model.Proje;
}
<div class="container py-4 project-management-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h1 class="h3 fw-bold mb-1">Proje Yönetimi</h1>
            <p class="text-muted mb-0">Giyim Mağazası ERP geliştirme, zaman, ekip ve bütçe görünümü.</p>
        </div>
        @if (proje is not null)
        {
            <span class="badge text-bg-success fs-6">@proje.Durum</span>
        }
    </div>
    <partial name="_ProjeMenu" />

    @if (proje is null)
    {
        <div class="alert alert-warning">
            Proje yönetimi verisi bulunamadı. Önce <strong>024_create_proje_yonetimi.sql</strong> scriptini çalıştırın.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-3 align-items-center">
                    <div class="col-lg-7">
                        <div class="small text-uppercase text-muted fw-semibold">Proje</div>
                        <h2 class="h4 fw-bold">@proje.ProjeAdi</h2>
                        <p class="text-muted mb-2">@proje.Aciklama</p>
                        <span class="small">@proje.BaslangicTarihi.ToString("dd.MM.yyyy") - @proje.PlanlananBitisTarihi.ToString("dd.MM.yyyy")</span>
                    </div>
                    <div class="col-lg-5">
                        @{
                            var projeOrani = Math.Clamp(Model.TamamlanmaOrani, 0, 100);
                        }
                        <div class="d-flex justify-content-between mb-2">
                            <strong>Proje Tamamlanma Oranı</strong>
                            <strong class="text-primary">%@projeOrani.ToString("N1")</strong>
                        </div>
                        <div class="progress project-main-progress" role="progressbar"
                             aria-valuenow="@projeOrani" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width:@projeOrani.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            @foreach (var kart in new[]
            {
                ("Toplam Görev", Model.ToplamGorev.ToString(), "primary"),
                ("Tamamlanan", Model.TamamlananGorev.ToString(), "success"),
                ("Devam Eden / Test", Model.DevamEdenGorev.ToString(), "info"),
                ("Kalan Görev", Model.KalanGorev.ToString(), "warning"),
                ("Kritik Kalan", Model.KritikGorev.ToString(), "danger")
            })
            {
                <div class="col-sm-6 col-xl">
                    <div class="card border-0 border-start border-4 border-@kart.Item3 shadow-sm h-100">
                        <div class="card-body"><div class="small text-muted">@kart.Item1</div><strong class="fs-4 text-@kart.Item3">@kart.Item2</strong></div>
                    </div>
                </div>
            }
        </div>
        <div class="row g-3 mb-4">
            @foreach (var kart in new[]
            {
                ("Planlanan Bütçe", Model.PlanlananButce.ToString("N2") + " TL", "primary"),
                ("Gerçekleşen Gider", Model.GerceklesenGider.ToString("N2") + " TL", "danger"),
                ("Net Proje Bütçesi", Model.NetButce.ToString("N2") + " TL", Model.NetButce >= 0 ? "success" : "danger")
            })
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="small text-muted">@kart.Item1</div><strong class="fs-5 text-@kart.Item3">@kart.Item2</strong>
                    </div></div>
                </div>
            }
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">Görev Durumu</h2>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark"><tr><th>Görev</th><th>Modül</th><th>Sorumlu</th><th>Bitiş</th><th>Öncelik</th><th>Durum</th><th>Tamamlanma</th></tr></thead>
                        <tbody>
                        @foreach (var gorev in Model.SonGorevler)
                        {
                            <tr>
                                <td class="fw-semibold">@gorev.GorevAdi</td>
                                <td>@gorev.ModulAdi</td>
                                <td>@(gorev.SorumluEkipUyesi?.AdSoyad ?? "-")</td>
                                <td>@gorev.BitisTarihi.ToString("dd.MM.yyyy")</td>
                                <td><span class="badge text-bg-@(gorev.Oncelik == "Kritik" ? "danger" : gorev.Oncelik == "Yüksek" ? "warning" : "secondary")">@gorev.Oncelik</span></td>
                                <td>@gorev.Durum</td>
                                @{
                                    var gorevOrani = Math.Clamp(gorev.TamamlanmaYuzdesi, 0, 100);
                                }
                                <td style="min-width:180px">
                                    <div class="project-progress-row">
                                        <div class="progress"><div class="progress-bar" style="width:@gorevOrani%"></div></div>
                                        <strong>%@gorevOrani</strong>
                                    </div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
