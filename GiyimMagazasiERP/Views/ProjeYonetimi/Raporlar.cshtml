@model GiyimMagazasiERP.ViewModels.ProjeRaporViewModel
@{ ViewData["Title"] = "Proje Raporları"; }
<div class="container py-4 project-management-page">
    <h1 class="h3 fw-bold mb-1">Proje Raporları</h1><p class="text-muted mb-3">Görev, ekip, modül, bütçe ve risk özetleri.</p>
    <partial name="_ProjeMenu" />
    <div class="row g-3 mb-4">@foreach(var k in new[]{("Toplam Görev",Model.ToplamGorev,"primary"),("Tamamlanan",Model.Tamamlanan,"success"),("Devam Eden",Model.DevamEden,"info"),("Testte",Model.Testte,"warning"),("Geciken",Model.Geciken,"danger")}){<div class="col-sm-6 col-xl"><div class="card border-0 border-start border-4 border-@k.Item3 shadow-sm"><div class="card-body"><div class="small text-muted">@k.Item1</div><strong class="fs-4 text-@k.Item3">@k.Item2</strong></div></div></div>}</div>
    <div class="row g-4 mb-4 project-report-grid">
        <div class="col-xl-7"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5 fw-bold">Modül Bazlı Rapor</h2><div class="table-responsive"><table class="table table-sm align-middle"><thead><tr><th>Modül</th><th>Görev</th><th>Tamamlanma</th><th>Test Durumu</th></tr></thead><tbody>@foreach(var x in Model.ModulRaporu){<tr><td>@x.ModulAdi</td><td>@x.GorevSayisi</td><td>%@x.TamamlanmaOrani.ToString("N2")</td><td>@x.TestDurumu</td></tr>}</tbody></table></div></div></div></div>
        <div class="col-xl-5"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h5 fw-bold">Bütçe Raporu</h2><dl class="row mb-0"><dt class="col-7">Planlanan bütçe</dt><dd class="col-5 text-end">@Model.PlanlananButce.ToString("N2") TL</dd><dt class="col-7">Gerçekleşen gider</dt><dd class="col-5 text-end">@Model.GerceklesenGider.ToString("N2") TL</dd><dt class="col-7">Kalan bütçe</dt><dd class="col-5 text-end">@Model.KalanButce.ToString("N2") TL</dd><dt class="col-7">Net bütçe</dt><dd class="col-5 text-end fw-bold">@Model.NetButce.ToString("N2") TL</dd></dl></div></div></div>
    </div>
    <div class="card border-0 shadow-sm mb-4"><div class="card-body"><h2 class="h5 fw-bold">Ekip Raporu</h2><div class="table-responsive"><table class="table table-sm table-hover align-middle"><thead><tr><th>Ekip Üyesi</th><th>Görev</th><th>Tamamlanan</th><th>Planlanan</th><th>Gerçekleşen</th><th>İş Yükü</th></tr></thead><tbody>@foreach(var x in Model.EkipRaporu){<tr><td>@x.EkipUyesi</td><td>@x.AtananGorev</td><td>@x.TamamlananGorev</td><td>@x.PlanlananSaat.ToString("N2")</td><td>@x.GerceklesenSaat.ToString("N2")</td><td>%@x.IsYukuYuzdesi.ToString("N2")</td></tr>}</tbody></table></div></div></div>
    <div class="row g-4">
        <div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6 fw-bold text-danger">Kritik Görevler</h2>@foreach(var x in Model.KritikGorevler){<div class="border-bottom py-2">@x.GorevAdi <span class="badge text-bg-@(x.TamamlanmaYuzdesi==100?"success":"danger") float-end">%@x.TamamlanmaYuzdesi</span></div>}</div></div></div>
        <div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6 fw-bold text-warning">Geciken Görevler</h2>@if(Model.GecikenGorevler.Any()){foreach(var x in Model.GecikenGorevler){<div class="border-bottom py-2">@x.GorevAdi</div>}}else{<p class="text-muted mb-0">Geciken görev yok.</p>}</div></div></div>
        <div class="col-lg-4"><div class="card border-0 shadow-sm h-100"><div class="card-body"><h2 class="h6 fw-bold text-danger">Bütçeyi Aşan Kalemler</h2>@if(Model.ButceAsanKalemler.Any()){foreach(var x in Model.ButceAsanKalemler){<div class="border-bottom py-2">@x.KalemAdi</div>}}else{<p class="text-muted mb-0">Bütçeyi aşan kalem yok.</p>}</div></div></div>
    </div>
</div>
