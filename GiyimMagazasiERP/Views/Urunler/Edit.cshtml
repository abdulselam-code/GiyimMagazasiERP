@model GiyimMagazasiERP.Models.Urun
@using System.Text.Json

@{
    ViewData["Title"] = "Ürün Düzenle";
    var altKategorilerJson = JsonSerializer.Serialize(ViewData["AltKategorilerJson"]);
    var tedarikciAltKategorilerJson = JsonSerializer.Serialize(ViewData["TedarikciAltKategorilerJson"]);
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold mb-4">Ürün Düzenle</h1>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OlusturmaTarihi" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="UrunAdi" class="form-label">Ürün Adı</label>
                        <input asp-for="UrunAdi" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Barkod" class="form-label">Barkod</label>
                        <input asp-for="Barkod" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="TedarikciId" class="form-label">Tedarikçi</label>
                        <select asp-for="TedarikciId"
                                asp-items="ViewBag.TedarikciId"
                                class="form-select"
                                id="tedarikciSecimi">
                            <option value="">Tedarikçi Seçiniz</option>
                        </select>
                        <span asp-validation-for="TedarikciId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="KategoriId" class="form-label">Ana Kategori</label>
                        <select asp-for="KategoriId"
                                asp-items="ViewBag.KategoriId"
                                class="form-select"
                                id="kategoriSecimi">
                            <option value="">Ana Kategori Seçiniz</option>
                        </select>
                        <span asp-validation-for="KategoriId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="AltKategoriId" class="form-label">Alt Kategori</label>
                        <select asp-for="AltKategoriId"
                                class="form-select"
                                id="altKategoriSecimi">
                            <option value="">Alt Kategori Seçiniz</option>
                        </select>

                        <div class="form-text">
                            Tedarikçi ve ana kategoriye göre filtrelenir. Zorunlu değildir.
                        </div>

                        <div id="tedarikciKategoriUyarisi" class="form-text text-warning"></div>

                        <span asp-validation-for="AltKategoriId" class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Beden" class="form-label">Beden</label>
                        <input asp-for="Beden" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Renk" class="form-label">Renk</label>
                        <input asp-for="Renk" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="AlisFiyati" class="form-label">Alış Fiyatı</label>
                        <input asp-for="AlisFiyati" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="SatisFiyati" class="form-label">Satış Fiyatı</label>
                        <input asp-for="SatisFiyati" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="StokMiktari" class="form-label">Stok Miktarı</label>
                        <input asp-for="StokMiktari" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="MinimumStok" class="form-label">Minimum Stok</label>
                        <input asp-for="MinimumStok" class="form-control" />
                    </div>

                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="AktifMi" class="form-check-input" />
                            <label asp-for="AktifMi" class="form-check-label">Aktif</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="application/json" id="altKategorilerJson">@Html.Raw(altKategorilerJson)</script>
<script type="application/json" id="tedarikciAltKategorilerJson">@Html.Raw(tedarikciAltKategorilerJson)</script>

@section Scripts {
    <script>
        (() => {
        const altKategoriler = JSON.parse(document.getElementById("altKategorilerJson").textContent || "[]");
        const tedarikciAltKategoriler = JSON.parse(document.getElementById("tedarikciAltKategorilerJson").textContent || "[]");

        const tedarikciSecimi = document.getElementById("tedarikciSecimi");
        const kategoriSecimi = document.getElementById("kategoriSecimi");
        const altKategoriSecimi = document.getElementById("altKategoriSecimi");
        const uyariAlani = document.getElementById("tedarikciKategoriUyarisi");

        const seciliKategoriId = "@Model.KategoriId";
        const seciliAltKategoriId = "@(Model.AltKategoriId?.ToString() ?? "")";

        const tumKategoriSecenekleri = Array.from(kategoriSecimi.options)
        .filter(x => x.value)
        .map(x => ({ value: x.value, text: x.textContent }));

        function tedarikciIliskileriGetir() {
        const tedarikciId = Number(tedarikciSecimi.value);

        return tedarikciAltKategoriler
        .filter(x => Number(x.TedarikciId) === tedarikciId);
        }

        function kategorileriYukle() {
        const iliskiler = tedarikciIliskileriGetir();
        const kategoriIdSet = new Set(iliskiler.map(x => String(x.KategoriId)));

        kategoriSecimi.innerHTML = '<option value="">Ana Kategori Seçiniz</option>';
        altKategoriSecimi.innerHTML = '<option value="">Alt Kategori Seçiniz</option>';

        if (!tedarikciSecimi.value) {
        uyariAlani.textContent = "Alt kategori seçimi için önce tedarikçi seçiniz.";
        kategoriSecimi.disabled = true;
        altKategoriSecimi.disabled = true;
        return;
        }

        if (iliskiler.length === 0) {
        uyariAlani.textContent = "Bu tedarikçi için sağladığı alt kategori tanımlanmamış.";
        kategoriSecimi.disabled = true;
        altKategoriSecimi.disabled = true;
        return;
        }

        uyariAlani.textContent = "";
        kategoriSecimi.disabled = false;
        altKategoriSecimi.disabled = false;

        tumKategoriSecenekleri
        .filter(x => kategoriIdSet.has(String(x.value)))
        .forEach(x => {
        const option = document.createElement("option");
        option.value = x.value;
        option.textContent = x.text;

        if (String(x.value) === String(seciliKategoriId)) {
        option.selected = true;
        }

        kategoriSecimi.appendChild(option);
        });

        altKategorileriYukle();
        }

        function altKategorileriYukle() {
        const kategoriId = Number(kategoriSecimi.value);
        const iliskiler = tedarikciIliskileriGetir();
        const izinliAltKategoriSet = new Set(iliskiler.map(x => String(x.AltKategoriId)));

        altKategoriSecimi.innerHTML = '<option value="">Alt Kategori Seçiniz</option>';

        altKategoriler
        .filter(x =>
        Number(x.KategoriId) === kategoriId &&
        izinliAltKategoriSet.has(String(x.Id)))
        .forEach(x => {
        const option = document.createElement("option");
        option.value = x.Id;
        option.textContent = x.AltKategoriAdi;

        if (String(x.Id) === seciliAltKategoriId) {
        option.selected = true;
        }

        altKategoriSecimi.appendChild(option);
        });
        }

        tedarikciSecimi.addEventListener("change", kategorileriYukle);
        kategoriSecimi.addEventListener("change", altKategorileriYukle);

        kategorileriYukle();
        })();
    </script>
}