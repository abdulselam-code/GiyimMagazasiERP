@model GiyimMagazasiERP.Models.Urun

@{
    ViewData["Title"] = "Ürün Sil";
}

<div class="container py-4">
    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold text-danger">Ürün Sil</h1>
            <p>Bu ürünü silmek istediğine emin misin?</p>

            <dl class="row">
                <dt class="col-sm-3">Ürün</dt>
                <dd class="col-sm-9">@Model.UrunAdi</dd>

                <dt class="col-sm-3">Barkod</dt>
                <dd class="col-sm-9">@Model.Barkod</dd>

                <dt class="col-sm-3">Kategori</dt>
                <dd class="col-sm-9">@Model.Kategori.KategoriAdi</dd>

                <dt class="col-sm-3">Tedarikçi</dt>
                <dd class="col-sm-9">@Model.Tedarikci.FirmaAdi</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Evet, Sil</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        </div>
    </div>
</div>