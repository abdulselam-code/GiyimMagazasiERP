@model GiyimMagazasiERP.ViewModels.AltKategoriListeViewModel

@{
    ViewData["Title"] = "Alt Kategoriler";

    var oncekiSayfa = Model.Page - 1;
    var sonrakiSayfa = Model.Page + 1;
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Alt Kategoriler</h1>
            <p class="text-muted mb-0">Ana kategoriye bağlı alt kategori yönetimi.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            Yeni Alt Kategori
        </a>
    </div>

    <section class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label for="arama" class="form-label">Arama</label>
                    <input type="text"
                           id="arama"
                           name="arama"
                           value="@Model.Arama"
                           class="form-control"
                           placeholder="Alt kategori, açıklama veya ana kategori ara" />
                </div>

                <div class="col-md-3">
                    <label for="kategoriId" class="form-label">Ana Kategori</label>
                    <select id="kategoriId"
                            name="kategoriId"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="">Tüm Kategoriler</option>
                        @foreach (var kategori in Model.Kategoriler)
                        {
                            <option value="@kategori.Value" selected="@kategori.Selected">
                                @kategori.Text
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="durum" class="form-label">Durum</label>
                    <select id="durum"
                            name="durum"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="Tumu" selected="@(Model.Durum == "Tumu")">Tümü</option>
                        <option value="Aktif" selected="@(Model.Durum == "Aktif")">Aktif</option>
                        <option value="Pasif" selected="@(Model.Durum == "Pasif")">Pasif</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="pageSize" class="form-label">Kayıt Sayısı</label>
                    <select id="pageSize"
                            name="pageSize"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="20" selected="@(Model.PageSize == 20)">20</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>

                <div class="col-md-1 d-grid">
                    <button type="submit" class="btn btn-primary">
                        Ara
                    </button>
                </div>

                <div class="col-12">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Temizle
                    </a>
                </div>
            </form>
        </div>
    </section>

    <section class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div class="text-muted">
                    Toplam <strong>@Model.TotalCount</strong> kayıt bulundu.
                </div>

                <div class="text-muted">
                    Sayfa <strong>@Model.Page</strong> / <strong>@(Model.TotalPages == 0 ? 1 : Model.TotalPages)</strong>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Ana Kategori</th>
                            <th>Alt Kategori</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th>Oluşturma Tarihi</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Arama kriterlerine uygun alt kategori bulunamadı.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.Kategori.KategoriAdi</td>
                                    <td class="fw-semibold">@item.AltKategoriAdi</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Aciklama) ? "-" : item.Aciklama)</td>
                                    <td>
                                        @if (item.AktifMi)
                                        {
                                            <span class="badge text-bg-success">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-secondary">Pasif</span>
                                        }
                                    </td>
                                    <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-info">
                                                Detay
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-primary">
                                                Düzenle
                                            </a>

                                            <form asp-action="DurumDegistir"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn @(item.AktifMi ? "btn-outline-warning" : "btn-outline-success")">
                                                    @(item.AktifMi ? "Pasifleştir" : "Aktifleştir")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4" aria-label="Alt kategori sayfalama">
                    <ul class="pagination justify-content-center mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-arama="@Model.Arama"
                               asp-route-kategoriId="@Model.KategoriId"
                               asp-route-durum="@Model.Durum"
                               asp-route-page="@oncekiSayfa"
                               asp-route-pageSize="@Model.PageSize">
                                Önceki
                            </a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-arama="@Model.Arama"
                                   asp-route-kategoriId="@Model.KategoriId"
                                   asp-route-durum="@Model.Durum"
                                   asp-route-page="@i"
                                   asp-route-pageSize="@Model.PageSize">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-arama="@Model.Arama"
                               asp-route-kategoriId="@Model.KategoriId"
                               asp-route-durum="@Model.Durum"
                               asp-route-page="@sonrakiSayfa"
                               asp-route-pageSize="@Model.PageSize">
                                Sonraki
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </section>
</div>