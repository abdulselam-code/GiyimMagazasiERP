@model List<GiyimMagazasiERP.Models.AltKategori>

@{
    ViewData["Title"] = "Alt Kategoriler";
    var arama = ViewBag.Arama?.ToString();
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Alt Kategoriler</h1>
            <p class="text-muted mb-0">Ana kategoriye bağlı ürün alt sınıflarını yönetin.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Yeni Alt Kategori</a>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-lg-9">
                    <label for="arama" class="form-label">Ara</label>
                    <input type="text"
                           id="arama"
                           name="arama"
                           value="@arama"
                           class="form-control"
                           placeholder="Alt kategori, ana kategori veya açıklama ara" />
                </div>

                <div class="col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">Ara</button>
                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Temizle</a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Ana Kategori</th>
                                <th>Alt Kategori</th>
                                <th>Açıklama</th>
                                <th>Oluşturma Tarihi</th>
                                <th>Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Kategori.KategoriAdi</td>
                                    <td class="fw-semibold">@item.AltKategoriAdi</td>
                                    <td>@(item.Aciklama ?? "-")</td>
                                    <td>@item.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                                    <td>
                                        <span class="badge @(item.AktifMi ? "text-bg-success" : "text-bg-secondary")">
                                            @(item.AktifMi ? "Aktif" : "Pasif")
                                        </span>
                                    </td>
                                    <td class="text-end text-nowrap">
                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Detay
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Düzenle
                                        </a>

                                        <form asp-action="DurumDegistir"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm @(item.AktifMi ? "btn-outline-secondary" : "btn-outline-success")">
                                                @(item.AktifMi ? "Pasifleştir" : "Aktifleştir")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center text-muted py-5">
                    Alt kategori kaydı bulunamadı.
                </div>
            }
        </div>
    </div>
</div>