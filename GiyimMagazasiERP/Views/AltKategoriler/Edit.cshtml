@model GiyimMagazasiERP.Models.AltKategori

@{
    ViewData["Title"] = "Alt Kategori Düzenle";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold mb-4">Alt Kategori Düzenle</h1>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OlusturmaTarihi" />

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="KategoriId" class="form-label">Ana Kategori</label>
                        <select asp-for="KategoriId"
                                asp-items="ViewBag.KategoriId"
                                class="form-select">
                            <option value="">Ana Kategori Seçiniz</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AltKategoriAdi" class="form-label">Alt Kategori Adı</label>
                        <input asp-for="AltKategoriAdi" class="form-control" />
                        <span asp-validation-for="AltKategoriAdi" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Aciklama" class="form-label">Açıklama</label>
                        <textarea asp-for="Aciklama" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="AktifMi" class="form-check-input" />
                            <label asp-for="AktifMi" class="form-check-label">Aktif</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>