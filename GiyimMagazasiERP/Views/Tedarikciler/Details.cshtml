@model GiyimMagazasiERP.Models.Tedarikci

@{
    ViewData["Title"] = "Tedarikçi Detayı";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold mb-4">Tedarikçi Detayı</h1>

            <dl class="row">
                <dt class="col-sm-3">Firma Adı</dt>
                <dd class="col-sm-9">@Model.FirmaAdi</dd>

                <dt class="col-sm-3">Telefon</dt>
                <dd class="col-sm-9">@(Model.Telefon ?? "-")</dd>

                <dt class="col-sm-3">Email</dt>
                <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

                <dt class="col-sm-3">Adres</dt>
                <dd class="col-sm-9">@(Model.Adres ?? "-")</dd>

                <dt class="col-sm-3">İndirim Oranı</dt>
                <dd class="col-sm-9">% @Model.IndirimOrani.ToString("N2")</dd>

                <dt class="col-sm-3">Ürün Sayısı</dt>
                <dd class="col-sm-9">@Model.Urunler.Count</dd>

                <dt class="col-sm-3">Durum</dt>
                <dd class="col-sm-9">@(Model.AktifMi ? "Aktif" : "Pasif")</dd>
            </dl>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Düzenle</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
        </div>
    </div>
</div>