@model GiyimMagazasiERP.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var admin = User.IsInRole("Admin");
    var yonetici = User.IsInRole("Yonetici");
    var kasiyer = User.IsInRole("Kasiyer");
    var personel = User.IsInRole("Personel");
    var depo = User.IsInRole("Depo");
    var muhasebe = User.IsInRole("Muhasebe");
    var insanKaynaklari = User.IsInRole("InsanKaynaklari");
    var yonetim = admin || yonetici;
    var satisPersoneli = kasiyer || personel;

    string Tl(decimal tutar) => tutar.ToString("N2") + " TL";
    string TarihSaat(DateTime? tarih) =>
        tarih?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz kayıt yok";

    string DurumMetni(string durum) => durum switch
    {
        "YoneticiOnayiBekliyor" => "Yönetici Onayı",
        "MuhasebeOnayiBekliyor" => "Muhasebe Onayı",
        "Tamamlandi" => "Tamamlandı",
        "SatisaDonusturuldu" => "Satışa Dönüştürüldü",
        "Reddedildi" => "Reddedildi",
        _ => durum
    };

    var gunlukSatisLabelsJson =
        JsonSerializer.Serialize(Model.GunlukSatisLabels);
    var gunlukSatisValuesJson =
        JsonSerializer.Serialize(Model.GunlukSatisValues);
    var gelirGiderLabelsJson =
        JsonSerializer.Serialize(Model.GelirGiderLabels);
    var gelirGiderValuesJson =
        JsonSerializer.Serialize(Model.GelirGiderValues);
    var enCokSatilanLabelsJson =
        JsonSerializer.Serialize(Model.EnCokSatilanUrunLabels);
    var enCokSatilanValuesJson =
        JsonSerializer.Serialize(Model.EnCokSatilanUrunValues);
    var kritikStokLabelsJson =
        JsonSerializer.Serialize(Model.KritikStokLabels);
    var kritikStokValuesJson =
        JsonSerializer.Serialize(Model.KritikStokValues);
    var aylikGelirGiderLabelsJson =
        JsonSerializer.Serialize(Model.AylikGelirGiderLabels);
    var aylikGelirValuesJson =
        JsonSerializer.Serialize(Model.AylikGelirValues);
    var aylikGiderValuesJson =
        JsonSerializer.Serialize(Model.AylikGiderValues);
    var stokHareketLabelsJson =
        JsonSerializer.Serialize(Model.StokHareketLabels);
    var stokGirisValuesJson =
        JsonSerializer.Serialize(Model.StokGirisValues);
    var stokCikisValuesJson =
        JsonSerializer.Serialize(Model.StokCikisValues);
    var iadeGirisValuesJson =
        JsonSerializer.Serialize(Model.IadeGirisValues);
    var iadeTrendLabelsJson =
        JsonSerializer.Serialize(Model.IadeTrendLabels);
    var iadeTrendValuesJson =
        JsonSerializer.Serialize(Model.IadeTrendValues);
}

<style>
    .erp-dashboard {
        --dash-border: #dfe5ec;
        --dash-muted: #64748b;
        --dash-text: #172033;
        width: 100%;
        max-width: 1440px;
        margin: 0 auto;
        padding: 24px 20px 40px;
        overflow-x: hidden;
    }

    .dashboard-hero {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        padding: clamp(22px, 3vw, 34px);
        color: #fff;
        background: #172033;
        border-radius: 8px;
    }

    .dashboard-role {
        display: inline-flex;
        padding: 4px 9px;
        margin-bottom: 10px;
        color: #dbeafe;
        border: 1px solid #475569;
        border-radius: 4px;
        font-size: .76rem;
        font-weight: 700;
    }

    .dashboard-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(150px, 1fr));
        gap: 10px;
        min-width: 330px;
    }

    .dashboard-meta div {
        padding: 10px 12px;
        background: #263449;
        border-radius: 6px;
    }

    .dashboard-meta span,
    .dashboard-meta strong {
        display: block;
    }

    .dashboard-meta span {
        color: #cbd5e1;
        font-size: .7rem;
    }

    .dashboard-meta strong {
        margin-top: 3px;
        font-size: .85rem;
    }

    .dashboard-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .dashboard-actions .btn {
        white-space: normal;
    }

    .dashboard-metric-link {
        display: block;
        height: 100%;
        color: inherit;
        text-decoration: none;
    }

    .dashboard-metric {
        height: 100%;
        padding: 16px;
        background: #fff;
        border: 1px solid var(--dash-border);
        border-left: 4px solid #2563eb;
        border-radius: 6px;
        transition: transform .16s ease, box-shadow .16s ease;
    }

    .dashboard-metric-link:hover .dashboard-metric {
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(15, 23, 42, .08);
    }

    .dashboard-metric.income { border-left-color: #15803d; }
    .dashboard-metric.expense { border-left-color: #dc2626; }
    .dashboard-metric.warning { border-left-color: #d97706; }
    .dashboard-metric.return { border-left-color: #ea580c; }
    .dashboard-metric.neutral { border-left-color: #64748b; }

    .dashboard-metric span {
        display: block;
        color: var(--dash-muted);
        font-size: .76rem;
        font-weight: 700;
    }

    .dashboard-metric strong {
        display: block;
        margin-top: 5px;
        color: var(--dash-text);
        font-size: 1.28rem;
        overflow-wrap: anywhere;
    }

    .dashboard-metric small {
        display: block;
        margin-top: 8px;
        color: #2563eb;
        font-weight: 600;
    }

    .dashboard-section-card {
        min-width: 0;
        height: 100%;
        border: 1px solid var(--dash-border) !important;
    }

    .dashboard-section-card .card-body {
        min-width: 0;
    }

    .dashboard-section-card .table-responsive {
        width: 100%;
    }

    .dashboard-chart-card {
        min-height: 350px;
    }

    .dashboard-chart-body {
        display: flex;
        min-width: 0;
        height: 100%;
        flex-direction: column;
    }

    .dashboard-chart-wrapper {
        position: relative;
        width: 100%;
        height: 280px;
        max-height: 300px;
        margin-top: auto;
    }

    .dashboard-chart-wrapper canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .dashboard-chart-empty {
        display: flex;
        min-height: 220px;
        align-items: center;
        justify-content: center;
        padding: 24px;
        color: var(--dash-muted);
        text-align: center;
        background: #f8fafc;
        border: 1px dashed #cbd5e1;
        border-radius: 6px;
    }

    .dashboard-list-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 11px 0;
        border-bottom: 1px solid #edf1f5;
    }

    .dashboard-list-row:last-child {
        border-bottom: 0;
    }

    .dashboard-list-row small {
        color: var(--dash-muted);
    }

    @@media (min-width: 768px) and (max-width: 1199.98px) {
        .erp-dashboard .row > .col-xl {
            flex: 0 0 auto;
            width: 50%;
        }
    }

    @@media (min-width: 1200px) {
        .erp-dashboard .row > .col-xl {
            flex: 0 0 auto;
            width: 25%;
        }
    }

    @@media (max-width: 768px) {
        .erp-dashboard {
            padding: 16px 12px 28px;
        }

        .dashboard-hero {
            display: block;
        }

        .dashboard-meta {
            grid-template-columns: 1fr;
            min-width: 0;
            margin-top: 18px;
        }

        .dashboard-chart-card {
            min-height: 292px;
        }

        .dashboard-chart-wrapper {
            height: 220px;
        }

        .dashboard-chart-empty {
            min-height: 170px;
        }
    }

    @@media (max-width: 575.98px) {
        .dashboard-actions .btn {
            flex: 1 1 100%;
        }

        .dashboard-list-row {
            align-items: flex-start;
            flex-wrap: wrap;
        }
    }
</style>

<div class="erp-dashboard">
    <section class="dashboard-hero mb-4">
        <div>
            <span class="dashboard-role">@Model.Rol</span>
            <h1 class="h3 fw-bold mb-2">Hoş geldiniz, @Model.KullaniciAdi</h1>
            <p class="mb-0 text-white-50">
                @if (yonetim)
                {
                    <text>İşletmenin satış, finans, stok ve bekleyen onaylarını tek ekrandan yönetin.</text>
                }
                else if (muhasebe)
                {
                    <text>Finans hareketlerini ve muhasebe onayı bekleyen işlemleri takip edin.</text>
                }
                else if (satisPersoneli)
                {
                    <text>Kendi satışlarınıza, taleplerinize ve günlük işlemlerinize hızlıca ulaşın.</text>
                }
                else if (depo)
                {
                    <text>Stok seviyelerini, hareketleri ve iadeden dönen ürünleri izleyin.</text>
                }
                else
                {
                    <text>Rolünüze ait güncel bilgileri ve işlemleri görüntüleyin.</text>
                }
            </p>
        </div>

        <div class="dashboard-meta">
            <div>
                <span>Bugün</span>
                <strong>@Model.BugununTarihi.ToString("dd.MM.yyyy")</strong>
            </div>
            <div>
                <span>Son İşlem</span>
                <strong>
                    @(depo
                        ? TarihSaat(Model.SonStokHareketiTarihi)
                        : TarihSaat(Model.SonFinansHareketiTarihi
                            ?? Model.SonSatisTarihi))
                </strong>
            </div>
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.UyariMesaji))
    {
        <div class="alert alert-warning">@Model.UyariMesaji</div>
    }

    @if (Model.HizliIslemler.Any())
    {
        <section class="mb-4">
            <h2 class="h6 fw-bold mb-2">Hızlı İşlemler</h2>
            <div class="dashboard-actions">
                @foreach (var link in Model.HizliIslemler)
                {
                    <a asp-controller="@link.Controller"
                       asp-action="@link.Action"
                       class="btn btn-sm btn-@link.Stil">
                        @link.Baslik
                    </a>
                }
            </div>
        </section>
    }

    @if (yonetim)
    {
        <section class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="Satislar" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric">
                        <span>Bugünkü Satış</span>
                        <strong>@Model.BugunkuSatisSayisi</strong>
                        <small>@Tl(Model.BugunkuSatisGeliri)</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="FinansHareketleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric income">
                        <span>Bugünkü Gelir</span>
                        <strong class="text-success">@Tl(Model.BugunkuGelir)</strong>
                        <small>Finans detayına git</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="FinansHareketleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric expense">
                        <span>Bugünkü Gider</span>
                        <strong class="text-danger">@Tl(Model.BugunkuGider)</strong>
                        <small>Bugünkü net: @Tl(Model.BugunkuNet)</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="IadeDegisimTalepleri"
                   asp-action="IadeBelgeleri"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric return">
                        <span>Bugünkü İade</span>
                        <strong class="text-danger">@Tl(Model.BugunkuIadeTutari)</strong>
                        <small>İade belgelerini aç</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="FinansHareketleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric income">
                        <span>Toplam Gelir</span>
                        <strong class="text-success">@Tl(Model.ToplamGelir)</strong>
                        <small>Net: @Tl(Model.NetKarZarar)</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="FinansHareketleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric expense">
                        <span>Toplam Gider</span>
                        <strong class="text-danger">@Tl(Model.ToplamGider)</strong>
                        <small>Finans hareketleri</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="ToptanSatisTalepleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric warning">
                        <span>Bekleyen Toptan Talepler</span>
                        <strong>@Model.BekleyenToptanTalepSayisi</strong>
                        <small>Onay ekranına git</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="IadeDegisimTalepleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric warning">
                        <span>Bekleyen İade Talepleri</span>
                        <strong>@Model.BekleyenIadeTalepSayisi</strong>
                        <small>@Model.TamamlananIadeBelgesiSayisi belge tamamlandı</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl-3">
                <a asp-controller="Urunler" asp-action="Index"
                   asp-route-kritikStok="true"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric warning">
                        <span>Kritik Stok</span>
                        <strong>@Model.KritikStokSayisi</strong>
                        <small>Kritik ürünleri göster</small>
                    </div>
                </a>
            </div>
        </section>

        <section class="row g-4 mb-4">
            <div class="col-xl-6">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Son Satışlar</h2>
                            <a asp-controller="Satislar" asp-action="Index"
                               class="btn btn-sm btn-outline-primary">Tümü</a>
                        </div>
                        @if (Model.SonSatislar.Any())
                        {
                            @await Html.PartialAsync("_DashboardSonSatislar", Model)
                        }
                        else
                        {
                            <p class="text-muted mb-0">Henüz satış yok.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Bekleyen Onaylar</h2>
                        </div>
                        @if (Model.BekleyenOnaylar.Any())
                        {
                            @foreach (var talep in Model.BekleyenOnaylar)
                            {
                                <div class="dashboard-list-row">
                                    <div>
                                        <strong>@talep.Modul · @talep.TalepNo</strong>
                                        <small class="d-block">
                                            @DurumMetni(talep.Durum) ·
                                            @talep.Tarih.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    <a asp-controller="@(talep.Modul == "İade"
                                           ? "IadeDegisimTalepleri"
                                           : "ToptanSatisTalepleri")"
                                       asp-action="Details"
                                       asp-route-id="@talep.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Aç
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Bekleyen onay yok.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Son İade Belgeleri</h2>
                            <a asp-controller="IadeDegisimTalepleri"
                               asp-action="IadeBelgeleri"
                               class="btn btn-sm btn-outline-secondary">Tümü</a>
                        </div>
                        @if (Model.SonIadeBelgeleri.Any())
                        {
                            @foreach (var belge in Model.SonIadeBelgeleri)
                            {
                                <div class="dashboard-list-row">
                                    <div>
                                        <strong>@belge.BelgeNo</strong>
                                        <small class="d-block">
                                            @belge.MusteriAdi · @Tl(belge.Tutar)
                                        </small>
                                    </div>
                                    <a asp-controller="IadeDegisimTalepleri"
                                       asp-action="Belge"
                                       asp-route-id="@belge.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Belge
                                    </a>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Henüz iade belgesi yok.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-6">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-2 mb-3">
                            <h2 class="h5 fw-bold mb-0">Kritik Stoktaki Ürünler</h2>
                            <a asp-controller="Urunler" asp-action="Index"
                               asp-route-kritikStok="true"
                               class="btn btn-sm btn-outline-warning">Tümü</a>
                        </div>
                        @if (Model.KritikStokUrunleri.Any())
                        {
                            @await Html.PartialAsync("_DashboardKritikStok", Model)
                        }
                        else
                        {
                            <p class="text-muted mb-0">Kritik stokta ürün yok.</p>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
    else if (muhasebe)
    {
        <section class="row g-3 mb-4">
            @foreach (var kart in new[]
            {
                ("Toplam Gelir", Tl(Model.ToplamGelir), "income"),
                ("Toplam Gider", Tl(Model.ToplamGider), "expense"),
                ("Net Tutar", Tl(Model.NetKarZarar), "neutral"),
                ("Satış İadeleri", Tl(Model.SatisIadeleriToplami), "return"),
                ("Bugünkü Net", Tl(Model.BugunkuNet), "neutral")
            })
            {
                <div class="col-sm-6 col-xl">
                    <a asp-controller="FinansHareketleri" asp-action="Index"
                       class="dashboard-metric-link">
                        <div class="dashboard-metric @kart.Item3">
                            <span>@kart.Item1</span>
                            <strong>@kart.Item2</strong>
                            <small>Finans detayına git</small>
                        </div>
                    </a>
                </div>
            }
            <div class="col-sm-6 col-xl">
                <a asp-controller="ToptanSatisTalepleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric warning">
                        <span>Toptan Muhasebe Onayı</span>
                        <strong>@Model.MuhasebeOnayiBekleyenToptanSayisi</strong>
                        <small>Bekleyen talepleri aç</small>
                    </div>
                </a>
            </div>
            <div class="col-sm-6 col-xl">
                <a asp-controller="IadeDegisimTalepleri" asp-action="Index"
                   class="dashboard-metric-link">
                    <div class="dashboard-metric warning">
                        <span>İade Muhasebe Onayı</span>
                        <strong>@Model.MuhasebeOnayiBekleyenIadeSayisi</strong>
                        <small>Bekleyen iadeleri aç</small>
                    </div>
                </a>
            </div>
        </section>

        <section class="row g-4 mb-4">
            <div class="col-xl-7">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Son Finans Hareketleri</h2>
                        @if (Model.SonFinansHareketleri.Any())
                        {
                            @foreach (var hareket in Model.SonFinansHareketleri)
                            {
                                <div class="dashboard-list-row">
                                    <div>
                                        <strong>@hareket.Kategori</strong>
                                        <small class="d-block">
                                            @hareket.Tarih.ToString("dd.MM.yyyy HH:mm")
                                        </small>
                                    </div>
                                    <strong class="@(hareket.HareketTipi == "Gelir"
                                        ? "text-success"
                                        : "text-danger")">
                                        @Tl(hareket.Tutar)
                                    </strong>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="card border-0 shadow-sm dashboard-section-card">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Son İade Belgeleri</h2>
                        @foreach (var belge in Model.SonIadeBelgeleri)
                        {
                            <div class="dashboard-list-row">
                                <div>
                                    <strong>@belge.BelgeNo</strong>
                                    <small class="d-block">@Tl(belge.Tutar)</small>
                                </div>
                                <a asp-controller="IadeDegisimTalepleri"
                                   asp-action="Belge"
                                   asp-route-id="@belge.Id"
                                   class="btn btn-sm btn-outline-primary">Aç</a>
                            </div>
                        }
                        @if (!Model.SonIadeBelgeleri.Any())
                        {
                            <p class="text-muted mb-0">Henüz iade belgesi yok.</p>
                        }
                    </div>
                </div>
            </div>
        </section>
    }
    else if (satisPersoneli)
    {
        <section class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                @if (kasiyer)
                {
                    <a asp-controller="Satislar" asp-action="Index"
                       asp-route-scope="benim" asp-route-tarih="bugun"
                       class="dashboard-metric-link">
                        <div class="dashboard-metric">
                            <span>Bugünkü Satışlarım</span>
                            <strong>@Model.BugunkuSatisSayisi</strong>
                            <small>@Tl(Model.BugunkuSatisGeliri)</small>
                        </div>
                    </a>
                }
                else
                {
                    <div class="dashboard-metric">
                        <span>Bugünkü Satışlarım</span>
                        <strong>@Model.BugunkuSatisSayisi</strong>
                        <small>@Tl(Model.BugunkuSatisGeliri)</small>
                    </div>
                }
            </div>
            <div class="col-sm-6 col-xl-3">
                @if (kasiyer)
                {
                    <a asp-controller="Satislar" asp-action="Index"
                       asp-route-scope="benim" asp-route-donem="buAy"
                       class="dashboard-metric-link">
                        <div class="dashboard-metric income">
                            <span>Bu Ay Satışlarım</span>
                            <strong>@Model.AylikSatisSayisi</strong>
