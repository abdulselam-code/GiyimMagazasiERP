@model GiyimMagazasiERP.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var admin = User.IsInRole("Admin");
    var yonetici = User.IsInRole("Yonetici");
    var kasiyer = User.IsInRole("Kasiyer");
    var depo = User.IsInRole("Depo");
    var muhasebe = User.IsInRole("Muhasebe");
    var insanKaynaklari = User.IsInRole("InsanKaynaklari");

    string Tl(decimal tutar) => tutar.ToString("N2") + " TL";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Dashboard</h1>
            <p class="text-muted mb-0">
                Hoş geldiniz, @Model.KullaniciAdi - Rolünüz: @Model.Rol
            </p>
        </div>

        @if (Model.HizliIslemler.Any())
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var link in Model.HizliIslemler)
                {
                    <a asp-controller="@link.Controller"
                       asp-action="@link.Action"
                       class="btn btn-@link.Stil">
                        @link.Baslik
                    </a>
                }
            </div>
        }
    </div>

    @if (admin)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Ürün Çeşidi</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Model.ToplamUrunCesidi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Stok Adedi</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Model.ToplamStokAdedi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Müşteri</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Model.ToplamMusteri</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-secondary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Personel</p>
                        <h3 class="h4 fw-bold text-secondary mb-0">@Model.ToplamPersonel</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-dark">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Satış</p>
                        <h3 class="h4 fw-bold text-dark mb-0">@Model.ToplamSatis</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <p class="text-muted mb-2">Kritik Stok</p>
                        <h3 class="h4 fw-bold text-warning mb-0">@Model.KritikStokSayisi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Gelir</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Tl(Model.ToplamGelir)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Gider</p>
                        <h3 class="h4 fw-bold text-danger mb-0">@Tl(Model.ToplamGider)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Net Kazanç</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Tl(Model.NetKazanc)</h3>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Son Satışlar</h2>
                        @await Html.PartialAsync("_DashboardSonSatislar", Model)
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Kritik Stok</h2>
                        @await Html.PartialAsync("_DashboardKritikStok", Model)
                    </div>
                </section>
            </div>
        </div>
    }
    else if (yonetici)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-dark">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Satış</p>
                        <h3 class="h4 fw-bold text-dark mb-0">@Model.ToplamSatis</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Müşteri</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Model.ToplamMusteri</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <p class="text-muted mb-2">Kritik Stok</p>
                        <h3 class="h4 fw-bold text-warning mb-0">@Model.KritikStokSayisi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Net Kazanç</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Tl(Model.NetKazanc)</h3>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Son Satışlar</h2>
                        @await Html.PartialAsync("_DashboardSonSatislar", Model)
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Kritik Stok</h2>
                        @await Html.PartialAsync("_DashboardKritikStok", Model)
                    </div>
                </section>
            </div>
        </div>
    }
    else if (kasiyer)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Bugünkü Satış Sayısı</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Model.BugunkuSatisSayisi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Bugünkü Satış Geliri</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Tl(Model.BugunkuSatisGeliri)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Müşteri</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Model.ToplamMusteri</h3>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">Son Satışlar ve Faturalar</h2>
                @await Html.PartialAsync("_DashboardSonSatislar", Model)
            </div>
        </section>
    }
    else if (depo)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Ürün Çeşidi</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Model.ToplamUrunCesidi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Stok Adedi</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Model.ToplamStokAdedi</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <p class="text-muted mb-2">Kritik Stok Sayısı</p>
                        <h3 class="h4 fw-bold text-warning mb-0">@Model.KritikStokSayisi</h3>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Son Stok Hareketleri</h2>
                        @await Html.PartialAsync("_DashboardStokHareketleri", Model)
                    </div>
                </section>
            </div>

            <div class="col-lg-6">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Kritik Stoktaki Ürünler</h2>
                        @await Html.PartialAsync("_DashboardKritikStok", Model)
                    </div>
                </section>
            </div>
        </div>
    }
    else if (muhasebe)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Gelir</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Tl(Model.ToplamGelir)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-danger">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Gider</p>
                        <h3 class="h4 fw-bold text-danger mb-0">@Tl(Model.ToplamGider)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Net Kazanç</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Tl(Model.NetKazanc)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Bugünkü Gelir</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Tl(Model.BugunkuGelir)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Aylık Gelir</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Tl(Model.AylikGelir)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <p class="text-muted mb-2">Aylık Gider</p>
                        <h3 class="h4 fw-bold text-warning mb-0">@Tl(Model.AylikGider)</h3>
                    </div>
                </div>
            </div>
        </section>

        <section class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">En Yüksek Giderler</h2>
                @await Html.PartialAsync("_DashboardGiderler", Model)
            </div>
        </section>
    }
    else if (insanKaynaklari)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Personel</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Model.ToplamPersonel</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Aktif Personel</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Model.AktifPersonel</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Ortalama Maaş</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Tl(Model.OrtalamaMaas)</h3>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <div class="col-lg-8">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Personel Listesi Özeti</h2>
                        @await Html.PartialAsync("_DashboardPersoneller", Model)
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Yakında</h2>
                        <div class="list-group">
                            <div class="list-group-item">İzin Yönetimi yakında</div>
                            <div class="list-group-item">Mesai Yönetimi yakında</div>
                            <div class="list-group-item">Maaş Ödemeleri yakında</div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }
    else
    {
        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 fw-bold">Hoş geldiniz, @Model.KullaniciAdi</h2>
                <p class="text-muted mb-2">Rolünüz: <strong>@Model.Rol</strong></p>
                <p class="mb-0">
                    Bu panelde size tanımlanan yetkiler kapsamında ERP sistemini görüntüleyebilirsiniz.
                    Yetkiniz olmayan modüller menülerde gösterilmez.
                </p>
            </div>
        </section>
    }

    @using System.Text.Json

@{
        var adminGrafikGorsun = User.IsInRole("Admin");
        var yoneticiGrafikGorsun = User.IsInRole("Yonetici");
        var kasiyerGrafikGorsun = User.IsInRole("Kasiyer");
        var depoGrafikGorsun = User.IsInRole("Depo");
        var muhasebeGrafikGorsun = User.IsInRole("Muhasebe");

        var gunlukSatisLabelsJson = JsonSerializer.Serialize(Model.GunlukSatisLabels);
        var gunlukSatisValuesJson = JsonSerializer.Serialize(Model.GunlukSatisValues);

        var gelirGiderLabelsJson = JsonSerializer.Serialize(Model.GelirGiderLabels);
        var gelirGiderValuesJson = JsonSerializer.Serialize(Model.GelirGiderValues);

        var kategoriSatisLabelsJson = JsonSerializer.Serialize(Model.KategoriSatisLabels);
        var kategoriSatisValuesJson = JsonSerializer.Serialize(Model.KategoriSatisValues);

        var enCokSatilanLabelsJson = JsonSerializer.Serialize(Model.EnCokSatilanUrunLabels);
        var enCokSatilanValuesJson = JsonSerializer.Serialize(Model.EnCokSatilanUrunValues);

        var kritikStokLabelsJson = JsonSerializer.Serialize(Model.KritikStokLabels);
        var kritikStokValuesJson = JsonSerializer.Serialize(Model.KritikStokValues);

        var aylikGelirGiderLabelsJson = JsonSerializer.Serialize(Model.AylikGelirGiderLabels);
        var aylikGelirValuesJson = JsonSerializer.Serialize(Model.AylikGelirValues);
        var aylikGiderValuesJson = JsonSerializer.Serialize(Model.AylikGiderValues);
    }

    @if (adminGrafikGorsun || yoneticiGrafikGorsun || kasiyerGrafikGorsun || depoGrafikGorsun || muhasebeGrafikGorsun)
    {
        <div class="container pb-4">
            <section class="mt-4">
                <div class="mb-3">
                    <h2 class="h4 fw-bold mb-1">Görsel Raporlar</h2>
                    <p class="text-muted mb-0">
                        Satış, stok ve finans verileri grafiklerle özetlenir.
                    </p>
                </div>

                <div class="row g-4">
                    @if (adminGrafikGorsun || yoneticiGrafikGorsun || kasiyerGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">Günlük Satış Grafiği</h3>
                                    @if (Model.GunlukSatisValues.Any())
                                    {
                                        <canvas id="gunlukSatisChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (adminGrafikGorsun || yoneticiGrafikGorsun || muhasebeGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">Gelir-Gider Grafiği</h3>
                                    @if (Model.GelirGiderValues.Any())
                                    {
                                        <canvas id="gelirGiderChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (adminGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">Kategori Bazlı Satış Grafiği</h3>
                                    @if (Model.KategoriSatisValues.Any())
                                    {
                                        <canvas id="kategoriSatisChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (adminGrafikGorsun || yoneticiGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">En Çok Satılan Ürünler</h3>
                                    @if (Model.EnCokSatilanUrunValues.Any())
                                    {
                                        <canvas id="enCokSatilanChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (adminGrafikGorsun || yoneticiGrafikGorsun || depoGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">Kritik Stok Grafiği</h3>
                                    @if (Model.KritikStokValues.Any())
                                    {
                                        <canvas id="kritikStokChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (muhasebeGrafikGorsun)
                    {
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body">
                                    <h3 class="h6 fw-bold">Aylık Gelir-Gider Grafiği</h3>
                                    @if (Model.AylikGelirGiderLabels.Any())
                                    {
                                        <canvas id="aylikGelirGiderChart" height="140"></canvas>
                                    }
                                    else
                                    {
                                        <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    }

    <script type="application/json" id="gunlukSatisLabelsJson">@Html.Raw(gunlukSatisLabelsJson)</script>
    <script type="application/json" id="gunlukSatisValuesJson">@Html.Raw(gunlukSatisValuesJson)</script>

    <script type="application/json" id="gelirGiderLabelsJson">@Html.Raw(gelirGiderLabelsJson)</script>
    <script type="application/json" id="gelirGiderValuesJson">@Html.Raw(gelirGiderValuesJson)</script>

    <script type="application/json" id="kategoriSatisLabelsJson">@Html.Raw(kategoriSatisLabelsJson)</script>
    <script type="application/json" id="kategoriSatisValuesJson">@Html.Raw(kategoriSatisValuesJson)</script>

