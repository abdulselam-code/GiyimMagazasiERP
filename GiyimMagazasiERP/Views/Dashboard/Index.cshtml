                                    <th>Satış Sayısı</th>
                                    <th class="text-end">Toplam Gelir</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OdemeTipineGoreGelirler)
                                {
                                    <tr>
                                        <td>@item.OdemeTipi</td>
                                        <td>@item.SatisSayisi</td>
                                        <td class="text-end fw-semibold">@Tl(item.ToplamGelir)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-muted py-4 text-center">Henüz gelir kaydı yok.</div>
                }
            </div>
        </section>

        <section class="card border-0 shadow-sm">
            <div class="card-body">
                <h2 class="h5 fw-bold mb-3">En Yüksek Giderler</h2>
                @await Html.PartialAsync("_DashboardGiderler", Model)
            </div>
        </section>
    }
    else if (insanKaynaklari)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-primary">
                    <div class="card-body">
                        <p class="text-muted mb-2">Toplam Personel</p>
                        <h3 class="h4 fw-bold text-primary mb-0">@Model.ToplamPersonel</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-success">
                    <div class="card-body">
                        <p class="text-muted mb-2">Aktif Personel</p>
                        <h3 class="h4 fw-bold text-success mb-0">@Model.AktifPersonel</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-info">
                    <div class="card-body">
                        <p class="text-muted mb-2">Ortalama Maaş</p>
                        <h3 class="h4 fw-bold text-info mb-0">@Tl(Model.OrtalamaMaas)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-warning">
                    <div class="card-body">
                        <p class="text-muted mb-2">En Yüksek Maaş</p>
                        <h3 class="h4 fw-bold text-warning mb-0">@Tl(Model.EnYuksekMaas)</h3>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm h-100 border-start border-4 border-secondary">
                    <div class="card-body">
                        <p class="text-muted mb-2">En Düşük Maaş</p>
                        <h3 class="h4 fw-bold text-secondary mb-0">@Tl(Model.EnDusukMaas)</h3>
                    </div>
                </div>
            </div>
        </section>

        <div class="row g-4">
            <div class="col-lg-8">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Personel Listesi Özeti</h2>
                        @await Html.PartialAsync("_DashboardPersoneller", Model)
                    </div>
                </section>
            </div>

            <div class="col-lg-4">
                <section class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <h2 class="h5 fw-bold mb-3">Yakında</h2>
                        <div class="list-group">
                            <div class="list-group-item">İzin Yönetimi yakında</div>
                            <div class="list-group-item">Mesai Yönetimi yakında</div>
                            <div class="list-group-item">Maaş Ödemeleri yakında</div>
                            <div class="list-group-item">Prim / Performans yakında</div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    }
    else
    {
        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 fw-bold">Hoş geldiniz, @Model.KullaniciAdi</h2>
                <p class="text-muted mb-2">Rolünüz: <strong>@Model.Rol</strong></p>
                <p class="mb-0">
                    Bu panelde size tanımlanan yetkiler kapsamında ERP sistemini görüntüleyebilirsiniz.
                    Yetkiniz olmayan modüller menülerde gösterilmez.
                </p>
            </div>
        </section>
    }

    @if (adminGrafikGorsun || yoneticiGrafikGorsun || kasiyerGrafikGorsun || depoGrafikGorsun || muhasebeGrafikGorsun)
    {
        <section class="mt-4">
            <div class="mb-3">
                <h2 class="h4 fw-bold mb-1">Görsel Raporlar</h2>
                <p class="text-muted mb-0">
                    Satış, stok ve finans verileri grafiklerle özetlenir.
                </p>
            </div>

            <div class="row g-4">
                @if (adminGrafikGorsun || yoneticiGrafikGorsun || kasiyerGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">Günlük Satış Grafiği</h3>
                                @if (Model.GunlukSatisValues.Any())
                                {
                                    <canvas id="gunlukSatisChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (adminGrafikGorsun || yoneticiGrafikGorsun || muhasebeGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">Gelir-Gider Grafiği</h3>
                                @if (Model.GelirGiderValues.Any())
                                {
                                    <canvas id="gelirGiderChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (adminGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">Kategori Bazlı Satış Grafiği</h3>
                                @if (Model.KategoriSatisValues.Any())
                                {
                                    <canvas id="kategoriSatisChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (adminGrafikGorsun || yoneticiGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">En Çok Satılan Ürünler</h3>
                                @if (Model.EnCokSatilanUrunValues.Any())
                                {
                                    <canvas id="enCokSatilanChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (adminGrafikGorsun || yoneticiGrafikGorsun || depoGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">Kritik Stok Grafiği</h3>
                                @if (Model.KritikStokValues.Any())
                                {
                                    <canvas id="kritikStokChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (muhasebeGrafikGorsun)
                {
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <h3 class="h6 fw-bold">Aylık Gelir-Gider Grafiği</h3>
                                @if (Model.AylikGelirGiderLabels.Any())
                                {
                                    <canvas id="aylikGelirGiderChart" height="140"></canvas>
                                }
                                else
                                {
                                    <p class="text-muted mb-0">Bu grafik için yeterli veri bulunamadı.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <script type="application/json" id="gunlukSatisLabelsJson">@Html.Raw(gunlukSatisLabelsJson)</script>
    <script type="application/json" id="gunlukSatisValuesJson">@Html.Raw(gunlukSatisValuesJson)</script>

    <script type="application/json" id="gelirGiderLabelsJson">@Html.Raw(gelirGiderLabelsJson)</script>
    <script type="application/json" id="gelirGiderValuesJson">@Html.Raw(gelirGiderValuesJson)</script>

    <script type="application/json" id="kategoriSatisLabelsJson">@Html.Raw(kategoriSatisLabelsJson)</script>
    <script type="application/json" id="kategoriSatisValuesJson">@Html.Raw(kategoriSatisValuesJson)</script>

    <script type="application/json" id="enCokSatilanLabelsJson">@Html.Raw(enCokSatilanLabelsJson)</script>
    <script type="application/json" id="enCokSatilanValuesJson">@Html.Raw(enCokSatilanValuesJson)</script>

    <script type="application/json" id="kritikStokLabelsJson">@Html.Raw(kritikStokLabelsJson)</script>
    <script type="application/json" id="kritikStokValuesJson">@Html.Raw(kritikStokValuesJson)</script>

    <script type="application/json" id="aylikGelirGiderLabelsJson">@Html.Raw(aylikGelirGiderLabelsJson)</script>
    <script type="application/json" id="aylikGelirValuesJson">@Html.Raw(aylikGelirValuesJson)</script>
    <script type="application/json" id="aylikGiderValuesJson">@Html.Raw(aylikGiderValuesJson)</script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
</div>