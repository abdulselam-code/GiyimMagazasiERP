    <script type="application/json" id="iadeTrendValuesJson">@Html.Raw(iadeTrendValuesJson)</script>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        if (typeof Chart !== "undefined") {
            Chart.defaults.responsive = true;
            Chart.defaults.maintainAspectRatio = false;
        }
    </script>
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const read = id => {
                const element = document.getElementById(id);
                return element ? JSON.parse(element.textContent || "[]") : [];
            };

            const iadeCanvas = document.getElementById("iadeTrendChart");
            if (iadeCanvas && typeof Chart !== "undefined") {
                new Chart(iadeCanvas, {
                    type: "line",
                    data: {
                        labels: read("iadeTrendLabelsJson"),
                        datasets: [{
                            label: "İade Tutarı",
                            data: read("iadeTrendValuesJson"),
                            borderColor: "#ea580c",
                            backgroundColor: "rgba(234, 88, 12, .12)",
                            fill: true,
                            tension: .3
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }

            const stokCanvas = document.getElementById("stokHareketChart");
            if (stokCanvas && typeof Chart !== "undefined") {
                new Chart(stokCanvas, {
                    type: "bar",
                    data: {
                        labels: read("stokHareketLabelsJson"),
                        datasets: [
                            {
                                label: "Giriş",
                                data: read("stokGirisValuesJson"),
                                backgroundColor: "#15803d"
                            },
                            {
                                label: "Çıkış",
                                data: read("stokCikisValuesJson"),
                                backgroundColor: "#dc2626"
                            },
                            {
                                label: "İade Girişi",
                                data: read("iadeGirisValuesJson"),
                                backgroundColor: "#ea580c"
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: { y: { beginAtZero: true } }
                    }
                });
            }
        });
    </script>
}
