@model GiyimMagazasiERP.ViewModels.DashboardViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";

    var admin = User.IsInRole("Admin");
    var yonetici = User.IsInRole("Yonetici");
    var kasiyer = User.IsInRole("Kasiyer");
    var depo = User.IsInRole("Depo");
    var muhasebe = User.IsInRole("Muhasebe");
    var insanKaynaklari = User.IsInRole("InsanKaynaklari");

    var adminGrafikGorsun = admin;
    var yoneticiGrafikGorsun = yonetici;
    var kasiyerGrafikGorsun = kasiyer;
    var depoGrafikGorsun = depo;
    var muhasebeGrafikGorsun = muhasebe;

    string Tl(decimal tutar) => tutar.ToString("N2") + " TL";
    string Tarih(DateTime? tarih) => tarih?.ToString("dd.MM.yyyy") ?? "Henüz kayıt yok";
    string TarihSaat(DateTime? tarih) => tarih?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz kayıt yok";

    var netClass = Model.NetKarZarar < 0 ? "text-danger" : "text-success";

    var gunlukSatisLabelsJson = JsonSerializer.Serialize(Model.GunlukSatisLabels);
    var gunlukSatisValuesJson = JsonSerializer.Serialize(Model.GunlukSatisValues);

    var gelirGiderLabelsJson = JsonSerializer.Serialize(Model.GelirGiderLabels);
    var gelirGiderValuesJson = JsonSerializer.Serialize(Model.GelirGiderValues);

    var kategoriSatisLabelsJson = JsonSerializer.Serialize(Model.KategoriSatisLabels);
    var kategoriSatisValuesJson = JsonSerializer.Serialize(Model.KategoriSatisValues);

    var enCokSatilanLabelsJson = JsonSerializer.Serialize(Model.EnCokSatilanUrunLabels);
    var enCokSatilanValuesJson = JsonSerializer.Serialize(Model.EnCokSatilanUrunValues);

    var kritikStokLabelsJson = JsonSerializer.Serialize(Model.KritikStokLabels);
    var kritikStokValuesJson = JsonSerializer.Serialize(Model.KritikStokValues);

    var aylikGelirGiderLabelsJson = JsonSerializer.Serialize(Model.AylikGelirGiderLabels);
    var aylikGelirValuesJson = JsonSerializer.Serialize(Model.AylikGelirValues);
    var aylikGiderValuesJson = JsonSerializer.Serialize(Model.AylikGiderValues);
}

<div class="container py-4 dashboard-page">
    <section class="dashboard-hero mb-4">
        <div>
            <span class="dashboard-role-badge">@Model.Rol</span>
            <h1 class="h3 fw-bold mb-1">Hoş geldiniz, @Model.KullaniciAdi</h1>

            <p class="mb-0">
                @if (admin || yonetici)
                {
                    <text>İşletmenin anlık satış, stok ve finans durumunu buradan takip edebilirsiniz.</text>
                }
                else if (kasiyer)
                {
                    <text>Satış ve fatura işlemleriniz için hızlı çalışma alanı.</text>
                }
                else if (depo)
                {
                    <text>Stok, ürün ve kritik stok durumunu takip edebilirsiniz.</text>
                }
                else if (muhasebe)
                {
                    <text>Gelir, gider ve finans hareketlerinin özeti.</text>
                }
                else if (insanKaynaklari)
                {
                    <text>Personel durumunu ve maaş özetlerini takip edebilirsiniz.</text>
                }
                else
                {
                    <text>ERP sisteminde size tanımlanan alanları görüntüleyebilirsiniz.</text>
                }
            </p>
        </div>

        <div class="dashboard-meta">
            <div>
                <span>Bugün</span>
                <strong>@Model.BugununTarihi.ToString("dd.MM.yyyy")</strong>
            </div>

            @if (admin || yonetici || kasiyer || muhasebe)
            {
                <div>
                    <span>Bu Ay</span>
                    <strong>
                        @Model.BuAyBaslangicTarihi.ToString("dd.MM.yyyy")
                        -
                        @Model.BuAyBitisTarihi.ToString("dd.MM.yyyy")
                    </strong>
                </div>
            }

            @if (depo)
            {
                <div>
                    <span>Son Stok Hareketi</span>
                    <strong>@TarihSaat(Model.SonStokHareketiTarihi)</strong>
                </div>
            }

            @if (muhasebe)
            {
                <div>
                    <span>Son Finans Hareketi</span>
                    <strong>@TarihSaat(Model.SonFinansHareketiTarihi)</strong>
                </div>
            }

            @if (insanKaynaklari)
            {
                <div>
                    <span>Personel Durum Tarihi</span>
                    <strong>@Model.BugununTarihi.ToString("dd.MM.yyyy")</strong>
                </div>
            }
        </div>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.UyariMesaji))
    {
        <div class="alert alert-warning">
            @Model.UyariMesaji
        </div>
    }

    @if (Model.HizliIslemler.Any())
    {
        <section class="dashboard-quick-actions mb-4">
            @foreach (var link in Model.HizliIslemler)
            {
                <a asp-controller="@link.Controller"
                   asp-action="@link.Action"
                   class="btn btn-@link.Stil">
                    @link.Baslik
                </a>
            }
        </section>
    }

    @if (admin || yonetici)
    {
        <section class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="dashboard-info-card">
                    <span>İşletme Kuruluş Tarihi</span>
                    <strong>@Tarih(Model.IsletmeKurulusTarihi)</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-info-card">
                    <span>İlk Satış Tarihi</span>
                    <strong>@(Model.IlkSatisTarihi?.ToString("dd.MM.yyyy") ?? "Henüz satış yok")</strong>
                </div>
            </div>

            <div class="col-md-4">
                <div class="dashboard-info-card">
                    <span>Son Satış Zamanı</span>
                    <strong>@(Model.SonSatisTarihi?.ToString("dd.MM.yyyy HH:mm") ?? "Henüz satış yok")</strong>
                </div>
            </div>
        </section>
    }

