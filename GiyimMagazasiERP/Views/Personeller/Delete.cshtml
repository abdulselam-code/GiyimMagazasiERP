@model GiyimMagazasiERP.Models.Personel

@{
    ViewData["Title"] = "Personel Sil";
}

<div class="container py-4">
    <div class="card border-danger shadow-sm">
        <div class="card-body">
            <h1 class="h4 fw-bold text-danger">Personel Sil</h1>
            <p>Bu personeli silmek istediğine emin misin?</p>

            <dl class="row">
                <dt class="col-sm-3">Ad Soyad</dt>
                <dd class="col-sm-9">@Model.AdSoyad</dd>

                <dt class="col-sm-3">Pozisyon</dt>
                <dd class="col-sm-9">@Model.Pozisyon</dd>

                <dt class="col-sm-3">Departman</dt>
                <dd class="col-sm-9">@Model.Departman</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Evet, Sil</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </form>
        </div>
    </div>
</div>