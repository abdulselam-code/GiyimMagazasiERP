@model GiyimMagazasiERP.ViewModels.PagedResultViewModel<GiyimMagazasiERP.Models.Personel>

@{
    ViewData["Title"] = "Personeller";

    var oncekiSayfa = Model.Page - 1;
    var sonrakiSayfa = Model.Page + 1;
    var siraNo = ((Model.Page - 1) * Model.PageSize) + 1;
    var durum = ViewData["Durum"]?.ToString() ?? "Aktif";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Personeller</h1>
            <p class="text-muted mb-0">Personel, pozisyon, prim, mesai ve izin bilgileri</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">Yeni Personel</a>
    </div>

    @if (TempData["Hata"] is not null)
    {
        <div class="alert alert-danger">@TempData["Hata"]</div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">
                <div class="col-lg-5">
                    <label for="arama" class="form-label">Personel Ara</label>
                    <input type="text"
                           id="arama"
                           name="arama"
                           value="@Model.Arama"
                           class="form-control"
                           placeholder="Ad soyad, telefon, email, pozisyon veya departman ara" />
                </div>

                <div class="col-sm-6 col-lg-2">
                    <label for="durum" class="form-label">Durum</label>
                    <select id="durum"
                            name="durum"
                            class="form-select"
                            onchange="this.form.submit()">
                        <option value="Aktif" selected="@(durum == "Aktif")">Aktif</option>
                        <option value="Pasif" selected="@(durum == "Pasif")">Pasif</option>
                        <option value="Tumu" selected="@(durum == "Tumu")">Tümü</option>
                    </select>
                </div>

                <div class="col-sm-6 col-lg-2">
                    <label for="pageSize" class="form-label">Kayıt Sayısı</label>
                    <select id="pageSize"
                            name="pageSize"
                            class="form-select"
                            onchange="this.form.submit()">
                        @if (Model.PageSize == 5)
                        {
                            <option value="5" selected>5</option>
                        }
                        else
                        {
                            <option value="5">5</option>
                        }

                        @if (Model.PageSize == 10)
                        {
                            <option value="10" selected>10</option>
                        }
                        else
                        {
                            <option value="10">10</option>
                        }

                        @if (Model.PageSize == 25)
                        {
                            <option value="25" selected>25</option>
                        }
                        else
                        {
                            <option value="25">25</option>
                        }

                        @if (Model.PageSize == 50)
                        {
                            <option value="50" selected>50</option>
                        }
                        else
                        {
                            <option value="50">50</option>
                        }

                        @if (Model.PageSize == 100)
                        {
                            <option value="100" selected>100</option>
                        }
                        else
                        {
                            <option value="100">100</option>
                        }
                    </select>
                </div>

                <div class="col-sm-6 col-lg-3">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-fill">
                            Ara
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
                            Temizle
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="text-muted small">
            @if (!string.IsNullOrWhiteSpace(Model.Arama))
            {
                <span>
                    Arama ve durum filtresine uygun <strong>@Model.TotalCount</strong> kayıt bulundu.
                </span>
            }
            else
            {
                <span>
                    <strong>@(durum == "Tumu" ? "Tüm" : durum)</strong> personeller:
                    <strong>@Model.TotalCount</strong> kayıt bulundu.
                </span>
            }
        </div>

        <div class="text-muted small">
            Sayfa <strong>@Model.Page</strong> / <strong>@(Model.TotalPages == 0 ? 1 : Model.TotalPages)</strong>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Ad Soyad</th>
                            <th>Telefon</th>
                            <th>Email</th>
                            <th>Pozisyon</th>
                            <th>Maaş</th>
                            <th>Prim</th>
                            <th>Giriş</th>
                            <th>Çıkış</th>
                            <th>Mesai Saati</th>
                            <th>İzin Günü</th>
                            <th>Departman</th>
                            <th>Durum</th>
                            <th>Etiket</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items.Any())
                        {
                            @foreach (var personel in Model.Items)
                            {
                                <tr>
                                    <td>@(siraNo++)</td>
                                    <td class="fw-semibold">@personel.AdSoyad</td>
                                    <td>@personel.Telefon</td>
                                    <td>@personel.Email</td>
                                    <td>@personel.Pozisyon</td>
                                    <td>@personel.Maas.ToString("N2") TL</td>
                                    <td>%@personel.PrimOrani.ToString("N2")</td>
                                    <td>@personel.GirisSaati</td>
                                    <td>@personel.CikisSaati</td>
                                    <td>@personel.MesaiSaati</td>
                                    <td>@personel.IzinGunu</td>
                                    <td>@personel.Departman</td>

                                    <td>
                                        <span class="badge @(personel.AktifMi ? "text-bg-success" : "text-bg-secondary")">
                                            @(personel.AktifMi ? "Aktif" : "Pasif")
                                        </span>
                                    </td>

                                    <td>
                                        @if (personel.PrimOrani > 0)
                                        {
                                            <span class="badge text-bg-primary">
                                                Primli Personel
                                            </span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        <a asp-action="Details"
                                           asp-route-id="@personel.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Detay
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@personel.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Düzenle
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@personel.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted py-4">
                                    Kayıt bulunamadı.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav class="mt-4" aria-label="Personel sayfalama">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.OncekiSayfaVarMi ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@oncekiSayfa"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-arama="@Model.Arama"
                   asp-route-durum="@durum">
                    Önceki
                </a>
            </li>

            @for (var sayfaNo = 1; sayfaNo <= Model.TotalPages; sayfaNo++)
            {
                <li class="page-item @(sayfaNo == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@sayfaNo"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-arama="@Model.Arama"
                       asp-route-durum="@durum">
                        @sayfaNo
                    </a>
                </li>
            }

            <li class="page-item @(Model.SonrakiSayfaVarMi ? "" : "disabled")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@sonrakiSayfa"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-arama="@Model.Arama"
                   asp-route-durum="@durum">
                    Sonraki
                </a>
            </li>
        </ul>
    </nav>
</div>
